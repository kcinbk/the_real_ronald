rchive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATodhdzVf", "is_twitter": false, "is_admin": false, "score": 15, "suggested_sort": 0, "post_flair_class": "", "id": 8936877, "raw_content": " interviewed a 22 year old for a pretty high paying entry level position in my company. After the usual interview questions he told me he had been looking for a job for almost 7 months but never got any calls back or even rejection emails. He seemed eager to get the position and could handle the basics of the job so I told him I would give him a call in the next day or two once his background check came back. \n\nwell right after he left I looked around on facebook, twitter and any social media I could think of just to ensure I wasn\u2019t going to be hiring a lefty and found out he is a big Fuentes fan. I called him back this morning to let him know we are going in a different direction.  \n\nit\u2019s pretty sad he probably would have done well and moved up fairly quickly through the ranks but you get what you vote for. The position is 55k a year to start and includes training on the older CNC machine before moving on to the good one but I feel putting fries in a bag may be more suitable for someone with a victim mentality.  ", "author": "2021is1776-2", "created": 1794491228839, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "getup", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "feeling pretty good this morning.", "last_comment_created": 1794496600431, "content": "<p>interviewed a 22 year old for a pretty high paying entry level position in my company. After the usual interview questions he told me he had been looking for a job for almost 7 months but never got any calls back or even rejection emails. He seemed eager to get the position and could handle the basics of the job so I told him I would give him a call in the next day or two once his background check came back.</p>\n<p>well right after he left I looked around on facebook, twitter and any social media I could think of just to ensure I wasn\u2019t going to be hiring a lefty and found out he is a big Fuentes fan. I called him back this morning to let him know we are going in a different direction.</p>\n<p>it\u2019s pretty sad he probably would have done well and moved up fairly quickly through the ranks but you get what you vote for. The position is 55k a year to start and includes training on the older CNC machine before moving on to the good one but I feel putting fries in a bag may be more suitable for someone with a victim mentality.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 17, "score_up": 15, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATodhdiC9", "is_twitter": false, "is_admin": false, "score": 23, "suggested_sort": 0, "post_flair_class": "", "id": 8936739, "raw_content": "", "author": "goodguy", "created": 1794482788730, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Your-personal-FBI", "is_video": false, "video_link": "", "is_new_user": false, "domain": "i.imgur.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATodhdiC9.png", "removal_source": "", "link": "https://i.imgur.com/wB5rWJA.gif", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Illinois is one of the wors