: false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": false, "linkEmbed": false, "replies": 6, "created": 1789661100000, "id": "2100617022988067302", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2045917978949222400/fJ0b2JGK_normal.jpg", "displayName": "Chief_Engineer", "username": "ChiefEngineerCE"}, "content": "**They Dont Work For You**\n\nWho gets the money when an American loses the job?\n\nNot the poor family in another country. Not the kid in your district. The cash moves from one elite pile to another. The company keeps the cheap wage. The staffing firm keeps the cut. The lobbyist", "parentTweet": false, "likes": 212}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVM9RGeD", "is_twitter": false, "is_admin": false, "score": 57, "suggested_sort": 0, "post_flair_class": "", "id": 8842295, "raw_content": "", "author": "goodguy", "created": 1789720178988, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "GallowsTime", "is_video": false, "video_link": "", "is_new_user": false, "domain": "i.imgur.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVM9RGeD.png", "removal_source": "", "link": "https://i.imgur.com/gu698BN.jpg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/0TfraGvkA9HFTsFp.jpeg", "width": 576, "content-type": "jpeg", "height": 768}], "blurhash": "UFG7[c%NxWRQ0$nBw|tQ*0#q-5o2z=t8w[s7", "full_resolution": [1020, 765]}, "title": "New Barbie", "last_comment_created": 1789737810337, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 3, "score_up": 57, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVM9SMVg", "is_twitter": false, "is_admin": false, "score": 23, "suggested_sort": 0, "post_flair_class": "", "id": 8842644, "raw_content": "Reposting again since it got worse.  He needs to get this under control before the election if he want to win.  This doesn't change my vote but would help pull over independents to our side. \r\n\r\nI know this might be controversial but he needs to do something to lower gas prices and reduce the leverage Iran has in the short term.\r\n\r\nHe could order the federal workforce he controls to work from home. He could ask the States to do the same for their workforce. He could ask private employers to do the same. He could ask our allies to do the same.\r\n\r\nI would want him to exclude K-12 school. I would want him to include colleges in this.\r\n\r\nThis whole thing would be to reduce the demand for gas by cutting down the commuting miles of as many workers as possible. This wouldn't be a lockdown. It would be more like what other Presidents have done during war time. Ask us to cut back on our travel in the least disruptive way as possible.\r\n\r\nSo far he has been asking us to bear the higher costs and the oil companies are reaping massive profits. This would hit them back on the demand side. He has to do something soon to lower the cost or this election will be ugly for conservatives. This is the fastest way I can think of to lower the high price of oil. This would give him time for his other actions to show they are working. This wouldn't be a long term solution but it could help right now, which is something we are sorely needing.", "author": "Joshua2001", "created": 1789737739803, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "TrumpVoter1", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "President Trump Should Use Work From Home To Lower Gas Prices", "last_comment_created": 1789751351723, "content": "<p>Reposting again since it got worse.  He needs to get this under control before the election if he want to win.  This doesn't change my vote but would help pull over independents to our side.</p>\n<p>I know this might be controversial but he needs to do something to lower gas prices and reduce the leverage Iran has in the short term.</p>\n<p>He could order the federal workforce he controls to work from home. He could ask the States to do the same for their workforce. He could ask private employers to do the same. He could ask our allies to do the same.</p>\n<p>I would want him to exclude K-12 school. I would want him to include colleges in this.</p>\n<p>This whole thing would be to reduce the demand for gas by cutting down the commuting miles of as many workers as possible. This wouldn't be a lockdown. It would be more like what other Presidents have done during war time. Ask us to cut back on our travel in the least disruptive way as possible.</p>\n<p>So far he has been asking us to bear the higher costs and the oil companies are reaping massive profits. This would hit them back on the demand side. He has to do something soon to lower the cost or this election will be ugly for conservatives. This is the fastest way I can think of to lower the high price of oil. This would give him time for his other actions to show they are working. This wouldn't be a long term solution but it could help right now, which is something we are sorely needing.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 12, "score_up": 23, "is_edited"