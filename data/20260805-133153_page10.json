_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 0, "score_up": 29, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATC9OlAuO", "is_twitter": false, "is_admin": false, "score": 25, "suggested_sort": 0, "post_flair_class": "", "id": 8764708, "raw_content": "In October 2024, Ken Paxton petitioned the Federal Election Commission (FEC) for new rules to close these loopholes and made a criminal referral to the Department of Justice regarding suspected fraud. \r\n\r\n**A federal judge blocked Paxton's lawsuit against ActBlue in June 2026**, ruling the legal action was politically motivated retaliation rather than legitimate law enforcement.  District Judge Richard Stearns found the investigation remained dormant until ActBlue raised $2.2 million for Paxton's Senate rival, James Talarico, in February 2026, concluding the suit violated First Amendment free speech protections. \r\n\r\nIncredible!\r\n\r\n", "author": "Bullet3250", "created": 1785933000353, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Trooph-Hurts", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "ACT BLUE FRAUD 'protected' by Dem Judges... ", "last_comment_created": 1785933347503, "content": "<p>In October 2024, Ken Paxton petitioned the Federal Election Commission (FEC) for new rules to close these loopholes and made a criminal referral to the Department of Justice regarding suspected fraud.</p>\n<p><strong>A federal judge blocked Paxton's lawsuit against ActBlue in June 2026</strong>, ruling the legal action was politically motivated retaliation rather than legitimate law enforcement.  District Judge Richard Stearns found the investigation remained dormant until ActBlue raised $2.2 million for Paxton's Senate rival, James Talarico, in February 2026, concluding the suit violated First Amendment free speech protections.</p>\n<p>Incredible!</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 25, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2085024551629361159", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATC9PreLs", "is_twitter": true, "is_admin": false, "score": 12, "suggested_sort": 0, "post_flair_class": "", "id": 8765044, "raw_content": "", "author": "PiratePatriotParrot", "created": 1785947351535, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "", "removal_source": "", "link": "https://twitter.com/i/status/2085024551629361159", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "The bystander who KNOCKED OUT Democrat congressional candidate Kirill Basin in Hawaii speaks out after the altercation went viral:\r\n\r\n\"As soon as he shoved me, I hit him with a left and a right... I didn't even know who the guy was\"", "last_comment_created": 1785947351535, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 0, "score_up": 12, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, 