ed": false, "is_image": true, "comments": 3, "score_up": 141, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1AToYvJ2td", "is_twitter": false, "is_admin": false, "score": 185, "suggested_sort": 0, "post_flair_class": "", "id": 8921999, "raw_content": "I was assured it is normal and common, unavoidable really, for elections to take several days to count, if not longer, that we had to count every vote and couldn't call a district or state because of all the late ballots that come in.\n\nWe didn't see that this time, no late night ballot dumps, no days to count or call races, it was pretty much all wrapped up before midnight.\n\nStrange, isn't it? ", "author": "bangbangshootshoot", "created": 1793798731216, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "blitzstrasse", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Isn't it interesting that it didn't take days or weeks to count the vote this time?", "last_comment_created": 1793804443445, "content": "<p>I was assured it is normal and common, unavoidable really, for elections to take several days to count, if not longer, that we had to count every vote and couldn't call a district or state because of all the late ballots that come in.</p>\n<p>We didn't see that this time, no late night ballot dumps, no days to count or call races, it was pretty much all wrapped up before midnight.</p>\n<p>Strange, isn't it?</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "