lair_class": "", "id": 8955326, "raw_content": "", "author": "PiratePatriotParrot", "created": 1795647174026, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "ColonelKlink", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATon3ohni.png", "removal_source": "", "link": "https://twitter.com/BasilTheGreat/status/2125557812399054964?a=J3BHAbGS4dfPgANQEI8&s=19", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Locals are WARNING Tourists against travelling to the Canary Islands\r\n\r\nOver TWO THOUSAND migrants landed in just one day this week\r\n\r\n\u201cIt\u2019s becoming overrun, things are going to get worse\u201d", "last_comment_created": 1795671129391, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 9, "score_up": 97, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": [{"width": 2048, "heightRatio": 63, "url": "https://pbs.twimg.com/media/HX9_jyVWcAAShAo.jpg", "height": 1303}], "linkEmbed": false, "replies": 104, "created": 1795607448000, "id": "2125557812399054964", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/1870853024798715904/f7G0cKa9_normal.jpg", "displayName": "Basil the Great", "username": "BasilTheGreat"}, "content": "\ud83d\udea8NEWS: Locals are WARNING Tourists against travelling to the Canary Islands\n\nOver TWO THOUSAND migrants landed in just one day this week\n\n\u201cIt\u2019s becoming overrun, things are going to get worse\u201d", "parentTweet": false, "likes": 2319}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATon3o9he", "is_twitter": false, "is_admin": false, "score": 168, "suggested_sort": 0, "post_flair_class": "toughsob", "id": 8955126, "raw_content": "I hope everyone has a wonderful Thanksgiving with your fam and friends. Do whatever you can to antogonize the lefties ; ) For the stories, ya know.\n\nThis is my first holiday season without my mother and it's really got me down bad. My mom, German and tough, adored Christmas. She put up the loveliest, most grand Christmas trees every year. Even last year when she could barely get out of bed she still put up her Christmas tree.\n\nIt appears we won't have one this year as my stepfather has said he doesn't want one. I'm going to go over and dig through all the Christmas stuff just to put a few things out. Mom would want that. \n\nI'm getting better. Officially in remission now. I will remain on meds for 5 years however I won't be taking the one that caused so many awful side effects. I'm slowly getting back to my self. A different version of me but still going. \n\nWhoever said cancer came for ChickNorris and ChickNorris kicked its ass was right! I can't believe I made it through but I did. I think I will finally allow myself to say \"I'm a fighter\". I always have been but I've always been too humble to say that about myself. Now? Yeah, I'm a fighter. \n\nI'm still putting quality time with family and friends above the politics. My  contribution to the US is to continue trying to guide the people in my life to the truth. \n\nThat's about it for the latest dispatch in my little corner of the world. Till next time... ", "author": "ChickNorris", "created": 1795636326694, "profile_picture": "Qe8wSmir2i1S", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Antho-2000", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Just Dropping by to say Happy Thanksgiving!", "last_comment_created": 1795663076617, "content": "<p>I hope everyone has a wonderful Thanksgiving with your fam and friends. Do whatever you can to antogonize the lefties ; ) For the stories, ya know.</p>\n<p>This is my first holiday season without my mother and it's really got me down bad. My mom, German and tough, adored Christmas. She put up the loveliest, most grand Christmas trees every year. Even last year when she could barely get out of bed she still put up her Christmas tree.</p>\n<p>It appears we won't have one this year as my stepfather has said he doesn't want one. I'm going to go over and dig through all the Christmas stuff just to put a few things out. Mom would want that.</p>\n<p>I'm getting better. Officially in remission now. I will remain on meds for 5 years however I won't be taking the one that caused so many awful side effects. I'm slowly getting back to my self. A different version of me but still going.</p>\n<p>Whoever said cancer came for ChickNorris and ChickNorris kicked its ass was right! I can't believe I made it through but I did. I think I will finally allow myself to say &quot;I'm a fighter&quot;. I always have been but I've always been too humble to say that about myself. Now? Yeah, I'm a fighter.</p>\n<p>I'm still putting quality time with family and friends above the politics. My  contribution to the US is to continue trying to guide the people in my life to the truth.</p>\n<p>That's about it for the latest dispatch in my little corner of the world. Till next time...</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 21, "score_up": 168, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "ONE\u00a0\u00a0TOUGH\u00a0\u00a0S.O.B.", "archive_i