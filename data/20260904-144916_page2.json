: "https://media.scored.co/preview/1ATV8A0TrC.png", "removal_source": "", "link": "https://twitter.com/sparksn123/status/2095542596500443341", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Congress: 531 hearings and ZERO arrests.", "last_comment_created": 1788547342180, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 12, "score_up": 198, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": [{"width": 543, "heightRatio": 100, "url": "https://pbs.twimg.com/media/HRTc4vGaEAELsgN.jpg", "height": 545}], "linkEmbed": false, "replies": 411, "created": 1788451262000, "id": "2095542596500443341", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/1562177046704377861/1vd3YQBS_normal.jpg", "displayName": "SparksN123", "username": "SparksN123"}, "content": "531 hearings and zero arrests.\nAt this point the only thing getting prosecuted is the taxpayer\u2019s wallet. Pretty sure.", "parentTweet": false, "likes": 5060}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATV8A0lIv", "is_twitter": false, "is_admin": false, "score": 122, "suggested_sort": 0, "post_flair_class": "", "id": 8816871, "raw_content": "I see a fair number of people posting about how they think that Lindsay Clancy should be sent to a mental institution for life. \n\nMassachusetts doesn't do that. The jury can either declare her guilty and send her to prison, or *not guilty* by reason of mental defect, and send her to a mental institution. Key words: not guilty. \n\nIn Mass, once someone is committed, they are evaluated for 6 months, and then have reevaluations every year after that. And if a doctor declares them cured, *they just get released*. They were found not guilty. There's no prison or lifelong commitment. They're committed until a psychologist says they're better, and they they walk free and clear. \n\nAnd with Mass being a Democrat state, 70% of psychologists being women, and 91% being Democrats...she's walking free within a year or two. ", "author": "SmiggieBalls", "created": 1788527612262, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "26magarat", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "70% of psychologists are women. 91% of psychologists are Democrats. Mass is a Democrat state. If Lindsay gets sent to a mental institution, she walks free. ", "last_comment_created": 1788547641889, "content": "<p>I see a fair number of people posting about how they think that Lindsay Clancy should be sent to a mental institution for life.</p>\n<p>Massachusetts doesn't do that. The jury can either declare her guilty and send her to prison, or <em>not guilty</em> by reason of mental defect, and send her to a mental institution. Key words: not guilty.</p>\n<p>In Mass, once someone is committed, they are evaluated for 6 months, and then have reevaluations every year after that. And if a doctor declares them cured, <em>they just get released</em>. They were found not guilty. There's no prison or lifelong commitment. They're committed until a psychologist says they're better, and they they walk free and clear.</p>\n<p>And with Mass being a Democrat state, 70% of psychologists being women, and 91% being Democrats...she's walking free within a year or two.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 9, "score_up": 122, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATV8A0CwL", "is_twitter": false, "is_admin": false, "score": 263, "suggested_sort": 0, "post_flair_class": "", "id": 8816631, "raw_content": "", "author": "goodguy", "created": 1788512516081, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "EffectiveTactics", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.scored.co", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATV8A0CwL.png", "removal_source": "", "link": "https://media.scored.co/post/DIpkKhRmg69Z.gif", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/cF1F0CrfNAzRtmoV.mp4", "width": 888, "content-type": "mp4", "height": 675}], "blurhash": "ULIh{cIAIV8_M|oekqM{~CtRW.x]DiNGs,t8", "full_resolution": [675, 888]}, "title": "LoL", "last_comment_created": 1788529008868, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 2, "score_up": 263, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}], "status": true}