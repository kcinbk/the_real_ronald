reference": "/scale/n8a82rSax6nHtqyp.jpeg", "width": 768, "content-type": "jpeg", "height": 612}], "blurhash": "U28E6$t7IU%M_3D%xuxt00IU?Had?cIU%Mxt", "full_resolution": [939, 1179]}, "title": "BLAMO", "last_comment_created": 1790985329188, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 5, "score_up": 140, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVVcSpQz", "is_twitter": false, "is_admin": false, "score": 33, "suggested_sort": 0, "post_flair_class": "tread", "id": 8867635, "raw_content": "Thanks to the Federal Reserve cartel and fiat currency, resulting in the creation of \"unlimited\" currency out of debt that has been wielded as a weapon (in some ways more powerful weapon than the use of arms) to influence state legislative bodies, local governments and agencies, businesses, and individuals directly.  It's made the District of Columbia into the District of Corruption.  It's given us unnecessary wars, the welfare state, and many other ills.  \n\nTwo possible solutions states taking actions such as making gold and silver itself legal tender (such as what Texas has done) and the creation of currencies backed by gold and silver by states.  Perhaps one day it will catch on to the point that fed fiat and any future CBDCs (either public or any public-private partnership CBDCs) will cease to become a viable weapon. Wishful thinking perhaps.", "author": "armyofpedes4usa", "created": 1790986758592, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Dmajallen", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Remember: Our nation was founded as a Union of States that were to govern with a good bit of autonomy with a weak fed gov. We now have a massive fed gov thanks largely to the Federal Reserve cartel and fiat currency.", "last_comment_created": 1790990556962, "content": "<p>Thanks to the Federal Reserve cartel and fiat currency, resulting in the creation of &quot;unlimited&quot; currency out of debt that has been wielded as a weapon (in some ways more powerful weapon than the use of arms) to influence state legislative bodies, local governments and agencies, businesses, and individuals directly.  It's made the District of Columbia into the District of Corruption.  It's given us unnecessary wars, the welfare state, and many other ills.</p>\n<p>Two possible solutions states taking actions such as making gold and silver itself legal tender (such as what Texas has done) and the creation of currencies backed by gold and silver by states.  Perhaps one day it will catch on to the point that fed fiat and any future CBDCs (either public or any public-private partnership CBDCs) will cease to become a viable weapon. Wishful thinking perhaps.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 1, "score_up": 33, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "\u00a0DON'T TREAD ON ME\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0", "archive_id": ""}, {"is_locked": false, "tweet_id": "2106037812923425130", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVVcSpdO", "is_twitter": true, "is_admin": false, "score": 31, "suggested_sort": 0, "post_flair_class": "", "id": 8867666, "raw_content": "", "author": "kinbergfan", "cre