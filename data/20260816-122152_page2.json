t": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATCIjobo6", "is_twitter": false, "is_admin": false, "score": 218, "suggested_sort": 0, "post_flair_class": "", "id": 8782696, "raw_content": "", "author": "Womb___Raider", "created": 1786846770259, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "KennyKetchem", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.patriots.win", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATCIjobo6.png", "removal_source": "", "link": "https://media.patriots.win/post/CUFewQu7CGrh.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/SGP0xdYhjduIDvs2.jpeg", "width": 642, "content-type": "jpeg", "height": 768}], "blurhash": "UiJjl3E2oeR*~qR*ofoMt-xtogoJpJxFj]kC", "full_resolution": [1291, 1080]}, "title": "I Would Rather Watch Paint Dry", "last_comment_created": 1786894467332, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 12, "score_up": 218, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATCIkvcY8", "is_twitter": false, "is_admin": false, "score": 24, "suggested_sort": 0, "post_flair_class": "", "id": 8783114, "raw_content": "Full book link: https://archive.org/details/St.TeresaOfAvilaTheInteriorCastleOrTheMansionsIncludingSomeOfHerMoreInterestingLetters/page/n25/mode/2up\n\n1900s Catholic encyclopedia biography: https://www.newadvent.org/cathen/14515b.htm\n\nvia Wikipedia \"Teresa of Avila\" entry:\n\n> The Interior Castle, or The Mansions (Spanish: El Castillo Interior or Las Moradas), was written in 1577 and published in 1588.[32][33] It contained the basis for what she felt should be the ideal journey of faith, comparing the contemplative soul to a castle with seven successive interior courts, or chambers, analogous to the seven mansions. The work was inspired by her vision of the soul as a diamond in the shape of a castle containing seven mansions, which she interpreted as the journey of faith through seven stages, ending with union with God.[34] \n\n> Fray Diego, one of Teresa's former confessors, wrote that God revealed to Teresa:\n\n> ... a most beautiful crystal globe, made in the shape of a castle, and containing seven mansions, in the seventh and innermost of which was the King of Glory, in the greatest splendour, illumining and beautifying them all. The nearer one got to the centre, the stronger was the light; outside the palace limits everything was foul, dark and infested with toads, vipers and other venomous creatures.\"", "author": "bluewhiteandred", "created": 1786892351203, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "\"The Interior Castle Or The Mansions\" by St. Teresa of Avila (16th Century)", "last_comment_created": 1786892351202, "content": "<p>Full book link: <a rel=\"nofollow\" href=\"https://archive.org/details/St.TeresaOfAvilaTheInteriorCastleOrTheMansionsIncludingSomeOfHerMoreInterestingLetters/page/n25/mode/2up\" target=\"_blank\">https://archive.org/details/St.TeresaOfAvilaTheInteriorCastleOrTheMansionsIncludingSomeOfHerMoreInterestingLetters/page/n25/mode/2up</a></p>\n<p>1900s Catholic encyclopedia biography: <a rel=\"nofollow\" href=\"https://www.newadvent.org/cathen/14515b.htm\" target=\"_blank\">https://www.newadvent.org/cathen/14515b.htm</a></p>\n<p>via Wikipedia &quot;Teresa of Avila&quot; entry:</p>\n<blockquote>\n<p>The Interior Castle, or The Mansions (Spanish: El Castillo Interior or Las Moradas), was written in 1577 and published in 1588.[32][33] It contained the basis for what she felt should be the ideal journey of faith, comparing the contemplative soul to a castle with seven successive interior courts, or chambers, analogous to the seven mansions. The work was inspired by her vision of the soul as a diamond in the shape of a castle containing seven mansions, which she interpreted as the journey of faith through seven stages, ending with union with God.[34]</p>\n</blockquote>\n<blockquote>\n<p>Fray Diego, one of Teresa's former confessors, wrote that God revealed to Teresa:</p>\n</blockquote>\n<blockquote>\n<p>... a most beautiful crystal globe, made in the shape of a castle, and containing seven mansions, in the seventh and innermost of which was the King of Glory, in the greatest splendour, illumining and beautifying them all. The nearer one got to the centre, the stronger was the light; outside the palace limits everything was foul, dark and infested with toads, vipers and other venomous creatures.&quot;</p>\n</blockquote>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 0, "score_up": 24, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2088827277165392030", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATCIjp9RI", "is_twitter": true, "is_admin": false, "score": 155, "suggested_sort": 0, "post_flair_class": "", "id": 8782828, "raw_content": "", "author": "PiratePatriotParrot", "created": 1786852677194, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Klaus73", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitte