ocked": false, "tweet_id": "2088711174007263304", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATCIm3kQ6", "is_twitter": true, "is_admin": false, "score": 366, "suggested_sort": 0, "post_flair_class": "", "id": 8784072, "raw_content": "", "author": "TruculentGoose", "created": 1786944831552, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "TerrorAndSlaughter", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATCIm3kQ6.png", "removal_source": "", "link": "https://twitter.com/Ghostofcynthia/status/2088711174007263304", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Noticing, really noticing", "last_comment_created": 1786995114326, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 44, "score_up": 366, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": false, "linkEmbed": false, "replies": 1493, "created": 1786822524000, "id": "2088711174007263304", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2087344321007620096/sJwxqH2c_normal.jpg", "displayName": "Cynthia Holt", "username": "Ghostofcynthia"}, "content": "Anyone else notice that nearly every country on the planet is wrestling with the exact same set of problems?\n\nMass illegal immigration, election cheating, extreme feminism, the ever expanding LGBTQIA+ pedophile groomer movement, collapsing birth rates, the rise of communism,", "parentTweet": false, "likes": 27766}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATCIm4qHf", "is_twitter": false, "is_admin": false, "score": 82, "suggested_sort": 0, "post_flair_class": "", "id": 8784427, "raw_content": "Adjudication happens when a ballot is unreadable by the machine, so an official(s) has to do a close inspection and determine themselves who the ballot is voting for, and then manually put in the votes themselves.\n\nAccording to the FEC, the acceptable rate of adjudication for a single batch is .000004(1 out of 250,000).\n\nIn the contested battleground states that kept counting for days and weeks, some counties had an adjudication rate of up to 68%. You read that right. Not .00068%, not .68%, not 6.8%, but 68 FUCKING PERCENT.\n\nAnd if that wasnt bad enough, heres the real kicker. That official(s) has to log in so that it tracks who it was that manually changed these votes. Well, that data was \"accidently\" erased, but funny enough, the data from the 2018 election was still on there.\n\nAint that some bullshit?", "author": "MAG-n-KAG", "created": 1786973874639, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "lostmypants", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Reminder that the rate of ballot adjudication during the 2020 steal was never addressed", "last_comment_created": 1786984018541, "content": "<p>Adjudication happens when a ballot is unreadable by the machine, so an official(s) has to do a close inspection and determine themselves who the ballot is voting for, and then manually put in the votes themselves.</p>\n<p>According to the FEC, the acceptable rate of adjudication for a single batch is .000004(1 out of 250,000).</p>\n<p>In the contested battleground states that kept counting for days and weeks, some counties had an adjudication rate of up to 68%. You read that right. Not .00068%, not .68%, not 6.8%, but 68 FUCKING PERCENT.</p>\n<p>And if that wasnt bad enough, heres the real kicker. That official(s) has to log in so that it tracks who it was that manually changed these votes. Well, that data was &quot;accidently&quot; erased, but funny enough, the data from the 2018 election was still on there.</p>\n<p>Aint that some bullshit?</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 9, "score_up": 82, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATCIm5OeB", "is_twitter": false, "is_admin": false, "score": 46, "suggested_sort": 0, "post_flair_class": "", "id": 8784663, "raw_content": "", "author": "ncswicn", "created": 1786985195482, "profile_picture": "vA8wUXPLp01X", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "ncswicn", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.scored.co", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATCIm5OeB.png", "removal_source": "", "link": "https://media.scored.co/post/QeB8HXNqrrXQ.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/0Kphdw9wjES8Mczb.png", "width": 501, "content-type": "png", "height": 768}], "blurhash": "U7L}BF0000~q00-;-;M{00-;-;IU_3j]a_Rj", "full_resolution": [911, 594]}, "title": "\"Pennsylvania News \n\nIn the last week, more democrats switched to Republican than vice versa. \n\nAlso, more democrats switched to No Party Affiliation than Republicans.\"", "last_comment_created": 1786986428738, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_ima