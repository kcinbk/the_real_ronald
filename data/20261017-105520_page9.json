tor": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVjYVnRX", "is_twitter": false, "is_admin": false, "score": 11, "suggested_sort": 0, "post_flair_class": "", "id": 8890647, "raw_content": "\u201cI have submitted to the Congress a certification that the issuance of such a waiver at this time is in the national interests of the United States,\u201d the president said in his order.\r\n\r\n... \r\n\r\nRussian Deputy Prime Minister Alexander Novak said on Oct. 12 that diesel exports could reach 3 million to 3.5 million metric tons per \u2060month by the end of the year, exceeding the volume announced by Trump.\r\nNovak also said that under the deal with Trump, Russian diesel supplies will partially balance global supply and \u200bdemand.\r\n\r\n\u201cWe will see how the situation develops further, but Russia has the capacity to increase diesel fuel exports,\u201d \u200bhe said on state TV channel Rossiya-24.\r\n\r\nTrump\u2019s executive order did not name the five major buyers of Russian oil and gas.\r\n\r\nData from the Centre for Research on Energy and Clean Air (CREA) show that China and India are the largest buyers of Russian crude oil, accounting for 50 percent and 36 percent, respectively, followed by Turkey and the European Union, each at 6 percent.\r\n\r\nEPOCH TIMES", "author": "Bullet3250", "created": 1792245471950, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "U.S. President Donald Trump issued an executive order on Oct. 16 waiving sanctions, restrictions, and duties targeting the top five countries that purchase Russian oil and gas.", "last_comment_created": 1792245471950, "content": "<p>\u201cI have submitted to the Congress a certification that the issuance of such a waiver at this time is in the national interests of the United States,\u201d the president said in his order.</p>\n<p>...</p>\n<p>Russian Deputy Prime Minister Alexander Novak said on Oct. 12 that diesel exports could reach 3 million to 3.5 million metric tons per \u2060month by the end of the year, exceeding the volume announced by Trump.\nNovak also said that under the deal with Trump, Russian diesel supplies will partially balance global supply and \u200bdemand.</p>\n<p>\u201cWe will see how the situation develops further, but Russia has the capacity to increase diesel fuel exports,\u201d \u200bhe said on state TV channel Rossiya-24.</p>\n<p>Trump\u2019s executive order did not name the five major buyers of Russian oil and gas.</p>\n<p>Data from the Centre for Research on Energy and Clean Air (CREA) show that China and India are the largest buyers of Russian crude oil, accounting for 50 percent and 36 percent, respectively, followed by Turkey and the European Union, each at 6 percent.</p>\n<p>EPOCH TIMES</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 0, "score_up": 11, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2111313769225662874", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVjYUhJX", "is_twitter": true, "is_admin": false, "score": 56, "suggested_sort": 0, "post_flair_class": "", "id": 8890257, "raw_content": "", "author": "PiratePatriotParrot", "created": 1792213578633, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Floridacus", "is_video": false