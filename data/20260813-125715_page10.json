s": [], "blurhash": "", "full_resolution": []}, "title": "Just so you\u2019re aware...", "last_comment_created": 1786609096324, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 410, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": false, "linkEmbed": false, "replies": 15, "created": 1786562201000, "id": "2087619297250103460", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2081179835762610176/cwAnbGrr_normal.jpg", "displayName": "Steve \ud83c\uddfa\ud83c\uddf8", "username": "SteveLovesAmmo"}, "content": "Just so you\u2019re aware a Mexican can\u2019t vote in election in Mexico without valid ID\u2026\n\nHe has to come to America to do that.", "parentTweet": false, "likes": 855}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATCE9wu3M", "is_twitter": false, "is_admin": false, "score": 22, "suggested_sort": 0, "post_flair_class": "", "id": 8778310, "raw_content": "https://thehill.com/regulation/court-battles/6026466-kirk-tyler-robinson-death-penalty-defense/\n\n\nLawyers for the man accused of killing political commentator Charlie Kirk during an event at Utah Valley University last year are now arguing the alleged shooter did not put any of the thousands of attendees in danger \u2014 a point they say prevents him from being eligible for the death penalty.\n\nIn Tuesday court filings, the legal team of the accused assassin, Tyler Robinson, wrote that he only \u201chit the intended target\u201d during the shooting. Given this claim, they say the state has failed to meet the burden of proof for an aggravated murder charge \u2014 a capital felony that requires prosecutors prove additional circumstances.", "author": "Joethebandit", "created": 1786624758641, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Addicted2Clickbait", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "PEOPLE ARE CONFUSED ON TYLER ROBINSON CASE- DEFENSE ADMITS GUILT- TRYING TO PREVENT DEATH PENALTY- THE CASE IS EFFECTIVELY OVER- JUST THE SENTENCING IS THE ISSUE NOW- DEFENSE TRYING TO SPARE HIS LIFE", "last_comment_created": 1786634579497, "content": "<p><a rel=\"nofollow\" href=\"https://thehill.com/regulation/court-battles/6026466-kirk-tyler-robinson-death-penalty-defense/\" target=\"_blank\">https://thehill.com/regulation/court-battles/6026466-kirk-tyler-robinson-death-penalty-defense/</a></p>\n<p>Lawyers for the man accused of killing political commentator Charlie Kirk during an event at Utah Valley University last year are now arguing the alleged shooter did not put any of the thousands of attendees in danger \u2014 a point they say prevents him from being eligible for the death penalty.</p>\n<p>In Tuesday court filings, the legal team of the accused assassin, Tyler Robinson, wrote that he only \u201chit the intended target\u201d during the shooting. Given this claim, they say the state has failed to meet the burden of proof for an aggravated murder charge \u2014 a capital felony that requires prosecutors prove additional circumstances.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 31, "score_up": 22, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false,