se, "video_link": "", "is_new_user": false, "domain": "nypost.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATC01QxZB.png", "removal_source": "", "link": "https://nypost.com/2026/07/22/business/number-of-americans-not-in-the-labor-force-surges-to-record-105-8m-as-total-exceeds-great-recession-covid-era/", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "105 million people not working in US", "last_comment_created": 1784969962868, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 175, "score_up": 701, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"description": "The number of adults who are \u201cnot in the labor force\u201d (NILF) surged to an all-time high in June to 105.8 million, according to figures from the Federal Reserve Bank of St. Louis.", "large_image": "QeW6Ghv2Z6cQK6B0.png", "title": "Shocking 105 million Americans are not working \u2013 more than during COVID or the Great Recession"}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATC01QyAM", "is_twitter": false, "is_admin": false, "score": 553, "suggested_sort": 0, "post_flair_class": "", "id": 8744892, "raw_content": "", "author": "StrongIsland", "created": 1784903955166, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Dudemanfoo", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.patriots.win", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATC01QyAM.png", "removal_source": "", "link": "https://media.patriots.win/post/NNRMQmtyhbCu.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/gjdviy9mhXwAznSd.jpeg", "width": 768, "content-type": "jpeg", "height": 507}], "blurhash": "U17BAm%M00D#9G-;~p-m00~q~qV=f,W=t6%L", "full_resolution": [772, 1170]}, "title": "Is there a word for this behavior?", "last_comment_created": 1784938133014, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 30, "score_up": 553, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATC02ZdP4", "is_twitter": false, "is_admin": false, "score": 47, "suggested_sort": 0, "post_flair_class": "", "id": 8745946, "raw_content": "Report all Democrat ads on Youtube and any streaming as MISLEADING OR SCAM. Reason:\n\nThe ad is an appeal by XXX (Named politician/candidate here). The appeal appeals for money for their campaign, but has zero reference to that when you click on the ad. Clicking it for donation sends you to ActBlue, which is a blanket political donation organization that is \u201cthe digital fundraising platform that Democratic candidates, progressive-aligned causes, and grassroots donors trust to raise the money they need to build change\u201d (per their website).\n1) There is no mention of the Democrat Party in the ad, making this misleading\n2) The ad is a direct appeal for a specific candidate, but ActBlue acts as a general pool of money for any cause they deem fit. This makes the ad a scam, because it is not a specific donation to the candidate appealing.\n\nNowhere in the ad mentions the Democrat Party affiliation to ActBlue, or the manner in which ActBlue disburses funds. This makes the ad a completely manipulative scam, and therefore not fit for the public.", "author": "Auroraalpha", "created": 1784951799459, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Antero", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "PSA for election season: Report all ActBlue ads", "last_comment_created": 1784959410294, "content": "<p>Report all Democrat ads on Youtube and any streaming as MISLEADING OR SCAM. Reason:</p>\n<p>The ad is an appeal by XXX (Named politician/candidate here). The appeal appeals for money for their campaign, but has zero reference to that when you click on the ad. Clicking it for donation sends you to ActBlue, which is a blanket political donation organization that is \u201cthe digital fundraising platform that Democratic candidates, progressive-aligned causes, and grassroots donors trust to raise the money they need to build change\u201d (per their website).</p>\n<ol>\n<li>There is no mention of the Democrat Party in the ad, making this misleading</li>\n<li>The ad is a direct appeal for a specific candidate, but ActBlue acts as a general pool of money for any cause they deem fit. This makes the ad a scam, because it is not a specific donation to the candidate appealing.</li>\n</ol>\n<p>Nowhere in the ad mentions the Democrat Party affiliation to ActBlue, or the manner in which ActBlue disburses funds. This makes the ad a completely manipulative scam, and therefore not fit for the public.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 47, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATC01Qgib", "is_twitter": false, "is_admin": fal