": false, "preview": "https://media.scored.co/preview/1ATVerpAnt.png", "removal_source": "", "link": "https://twitter.com/ScottPresler/status/2108931644858024094", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Oklahoma loses another voter! ", "last_comment_created": 1791672169593, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 4, "score_up": 49, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": [{"width": 1206, "heightRatio": 69, "url": "https://pbs.twimg.com/media/HURuJzuWcAA0gcP.jpg", "height": 834}], "linkEmbed": false, "replies": 1111, "created": 1791643460000, "id": "2108931644858024094", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/1321124227215491072/pIC0lG5M_normal.jpg", "displayName": "ThePersistence", "username": "ScottPresler"}, "content": "Oklahoma is losing another voter.", "parentTweet": false, "likes": 6804}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVerpB0F", "is_twitter": false, "is_admin": false, "score": 46, "suggested_sort": 0, "post_flair_class": "", "id": 8880143, "raw_content": "Besides hosting one at your home, there are tons of venues that you can either use for free or rent, including:\n\nSports Bars\n\nCigar Lounges\n\nBreweries and Taprooms\n\nDrive-in Theaters\n\nBowling Alleys\n\nArcades and Entertainment Complexes\n\nCommunity Centers\n\nApartment & HOA Clubhouses\n\nIf it's at night, you can even get a portable projector and screen and do it in your backyard, in a parking lot. or at a park.\n\nIf you are attempting to rent someplace out that's not based AF, I would suggest being vague about what the watch party is for. Get a contract. Make sure they can't cancel it once they find out.", "author": "DemPanicAtTheDisco", "created": 1791667971714, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "prayinpede", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Wanna trigger the leftists? Execution watch parties.", "last_comment_created": 1791673018249, "content": "<p>Besides hosting one at your home, there are tons of venues that you can either use for free or rent, including:</p>\n<p>Sports Bars</p>\n<p>Cigar Lounges</p>\n<p>Breweries and Taprooms</p>\n<p>Drive-in Theaters</p>\n<p>Bowling Alleys</p>\n<p>Arcades and Entertainment Complexes</p>\n<p>Community Centers</p>\n<p>Apartment &amp; HOA Clubhouses</p>\n<p>If it's at night, you can even get a portable projector and screen and do it in your backyard, in a parking lot. or at a park.</p>\n<p>If you are attempting to rent someplace out that's not based AF, I would suggest being vague about what the watch party is for. Get a contract. Make sure they can't cancel it once they find out.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 12, "score_up": 46, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVaLP8iX", "is_twitter": false, "is_admin": false, "score": 117, "suggested_sort": 0, "post_flair_class": "", "id": 8879731, "raw_content": "", "author": "Oodles", "created": 1791648901343, "profile_picture": "", "community": "TheDonald", "ad