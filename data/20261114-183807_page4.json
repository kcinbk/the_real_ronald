or": "billybaldwin2", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "", "removal_source": "", "link": "https://twitter.com/ScottMechkowski/status/2121636163970548161", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "\n\nScott Mechkowski\n@ScottMechkowski\n\u00b7\nThe \"disappeared\" narrative is still making the rounds, so let me say it again. ICE doesn't kidnap anyone.", "last_comment_created": 1794699309728, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 29, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": {"quotedTweet": false, "images": [{"width": 1290, "heightRatio": 62, "url": "https://pbs.twimg.com/media/HW7Q2Y9WwAE9wsf.jpg", "height": 805}, {"width": 1176, "heightRatio": 86, "url": "https://pbs.twimg.com/media/HW7Q2ZAW4AApKP4.jpg", "height": 1020}, {"width": 1343, "heightRatio": 66, "url": "https://pbs.twimg.com/media/HW7Q2Y-XoAAnfQ9.jpg", "height": 896}, {"width": 1204, "heightRatio": 82, "url": "https://pbs.twimg.com/media/HW7Q2ZCWgAAsNVJ.jpg", "height": 996}], "linkEmbed": false, "replies": 0, "created": 1794515400000, "id": "2120977432778088624", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2099475340523626496/Pdt1aMU__normal.jpg", "displayName": "Scott Mechkowski", "username": "ScottMechkowski"}, "content": "\ud83d\udea8 ICE DOESN'T KIDNAP AND IT DOESN'T \"DISAPPEAR\" ANYONE. THE NARRATIVE IS THE POINT.\n\nThe New York Times and the open-borders lawyers say ICE is \"disappearing\" people. That's a lie.\n\nNobody disappeared. ICE knows exactly where every detainee is, and every one of them can pick up", "parentTweet": false, "likes": 217}, "images": fa