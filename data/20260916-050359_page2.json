uCexmJ6GwJKHS-m.m3u8?v=1fa", "aspectRatio": [9, 16], "heightRatio": 177, "type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2045836434280763392/vid/avc1/320x568/RT197uZ4--rUfqKZ.mp4"}, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2052522025315450884/W_HA5SRj_normal.jpg", "displayName": "Jason Bartlett", "username": "Jason2bartlett"}, "content": "I\u2019m just a white South African being left alone to thrive in Alabama \n\nGod is good", "parentTweet": false, "likes": 57635}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVHXLFlI", "is_twitter": false, "is_admin": false, "score": 410, "suggested_sort": 0, "post_flair_class": "", "id": 8836888, "raw_content": "Charge was felony hit and run. He plead guilty and was sentened to 3 months jail, 2 years supervised probation, 6 months alcohol consumption monitoring. \n\nThat's it. He took a life. He drove away after running over my nephew. He saw him on the ground, dead. He got 3 months in jail. \n\nThere is no justice in the US anymore. At least not in North Carolina. \n\nThe guy's name is Andres Amaya Velasquez. He also plead guilty to no operators license and no registration last year. That charge probably stems from the hit and run. I'm trying to find the public record of the charges and final dispostion. Will add those to this post whenever it updates online. ", "author": "ChickNorris", "created": 1789492860149, "profile_picture": "Qe8wSmir2i1S", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "HockeyMom4Trump", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "The hispanic man that killed my nephew was sentenced today", "last_