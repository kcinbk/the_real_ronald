ted_sort": 0, "post_flair_class": "", "id": 8841756, "raw_content": "", "author": "1inchgroup", "created": 1789685866444, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "1inchgroup", "is_video": true, "video_link": "https://www.youtube.com/embed/oWW1Z7xKoiI?start=0", "is_new_user": false, "domain": "www.youtube.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVM8KF6c.png", "removal_source": "", "link": "https://www.youtube.com/watch?v=oWW1Z7xKoiI", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "He found gold at his little old school claim on public land!!!!!   This is the dude that bought the old silver mine in the Owens Valley.", "last_comment_created": 1789689206042, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 8, "score_up": 19, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVM8KWHo", "is_twitter": false, "is_admin": false, "score": 14, "suggested_sort": 0, "post_flair_class": "", "id": 8841870, "raw_content": "This is a stretch in regards to what I had been told about Flock cameras located at Home Depot and Lowes, so bear that in mind\n\nAs I was checking out, I asked an employee what the deal was with the four cameras installed around the perimeter of the parking lot. What he had to say concerned me, but it given the stigma of Flock as of late, it also wouldn't surprise me.\n\nI had been told that Flock is paying out incentives per-camera to companies (up to $35k.) That number alone is alarming, but it all hinges on a contract agreement made with Flock containing unknown language that I'm fairly certain most in the loop of how Flock has been tracking and identifying people that it isn't for anything omnipotent.\n\nOn a normal day, hearing something like this amounts to literal hearsay and I would ignore it. Some things about Flock don't make sense to me, however, and it makes me question the veracity of the claims, as I disapprove of anyone spying on me. How do they get the money to pay anyone with something like that? It's so outlandish that there has to be some layer of truth to it that just isn't public knowledge yet.", "author": "mikethemarine", "created": 1789691733067, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "MyDadLikedBiden", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Unverified: What I was told regarding Flock cameras", "last_comment_created": 1789697591357, "content": "<p>This is a stretch in regards to what I had been told about Flock cameras located at Home Depot and Lowes, so bear that in mind</p>\n<p>As I was checking out, I asked an employee what the deal was with the four cameras installed around the perimeter of the parking lot. What he had to say concerned me, but it given the stigma of Flock as of late, it also wouldn't surprise me.</p>\n<p>I had been told that Flock is paying out incentives per-camera to companies (up to $35k.) That number alone is alarming, but it all hinges on a contract agreement made with Flock containing unknown language that I'm fairly certain most in the loop of how Flock has been tracking and identifying people that it isn't for anything omnipotent.</p>\n<p>On a normal day, hearing something like this amounts to literal hearsay and I would ignore it. Some things about Flock don't make sense to me, however, and it makes me question the veracity of the claims, as I disapprove of anyone spying on me. How do they get the money to pay anyone with something like that? It's so outlandish that there has to be some layer of truth to it that just isn't public knowledge yet.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 3, "score_up": 14, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2100607011444428881", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVM9Qhwz", "is_twitter": true, "is_admin": false, "score": 11, "suggested_sort": 0, "post_flair_class": "", "id": 8842005, "raw_content": "", "author": "PiratePatriotParrot", "created": 1789698215492, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "dukeofdoorcounty", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVM9Qhwz.png", "removal_source": "", "link": "https://twitter.com/lilykepner/status/2100607011444428881", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "NEW: \n@UTAustin\n quietly cuts ethnic, gender studies majors from new student applications\n\nFuture students can no longer major in Women\u2019s, Sexualities & Gender studies; Mexican American & Latina/o studies; African & African Diaspora studies as of fall 2027.", "last_comment_created": 1789700436450, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 11, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet"