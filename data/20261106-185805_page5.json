_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 2, "score_up": 43, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1AToZ26Jkq", "is_twitter": false, "is_admin": false, "score": 31, "suggested_sort": 0, "post_flair_class": "dei", "id": 8927584, "raw_content": "No, members of Congress do not automatically receive or hold traditional security clearances. \n\nReddit\n\u00b7r/SecurityClearance\n +1\nInstead, lawmakers bypass the standard executive-branch background check process. By tradition and constitutional design, they are deemed inherently trustworthy to access classified information simply by virtue of being elected to their office. \n\nCongress.gov\n +3\nKey facts about how security and access work for Congress include:\nNo Background Checks: Members do not undergo the FBI or executive branch background investigations required for federal employees, military personnel, or contractors. \n\nReddit\n\u00b7r/SecurityClearance\n +1\nAccess vs. Clearance: They do not hold a \"clearance\" per se; rather, they have constitutional and traditional eligibility to access classified materials based on their role and a \"need-to-know\" (often tied to specific committee assignments like the intelligence or armed services committees). \n\nRoll Call\n +1\nOaths of Secrecy: Lawmakers take secrecy oaths upon taking office, and they can face internal congressional discipline\u2014including potential expulsion by a two-thirds vote\u2014if they leak classified information. \n\nWUSA9\n +3\nStaff Are Different: Unlike the members themselves, congressional aides and personal or committee staff do have to go through formal background investigations and obtain security clearances to handle classified files. \n\nGovExec.com\n +2\nFor further details on how these rules are structured, read the Congressional Research Service FAQ on Security Clearances or examine industry perspectives on Roll Call. \n", "author": "MajorClark", "created": 1794003715867, "profile_picture": "FIsgRa9onFDM", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "_Sully_", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "No, members of Congress and U.S. Senators do not need or hold traditional security clearances to be elected or to work in office.  Federal, military and contractors have to have one so why not them?     Close this loophole now! ", "last_comment_created": 1794006478966, "content": "<p>No, members of Congress do not automatically receive or hold traditional security clearances.</p>\n<p>Reddit\n\u00b7r/SecurityClearance\n+1\nInstead, lawmakers bypass the standard executive-branch background check process. By tradition and constitutional design, they are deemed inherently trustworthy to access classified information simply by virtue of being elected to their office.</p>\n<p>Congress.gov\n+3\nKey facts about how security and access work for Congress include:\nNo Background Checks: Members do not undergo the FBI or executive branch background investigations required for federal employees, military personnel, or contractors.</p>\n<p>Reddit\n\u00b7r/SecurityClearance\n+1\nAccess vs. Clearance: They do not hold a &quot;clearance&quot; per se; rather, they have constitutional and traditional eligibility to access classified materials based on their role and a &quot;need-to-know&quot; (often tied to specific committee assignments like the intelligence or armed services committees).</p>\n<p>Roll Call\n+1\nOaths of Secrecy: Lawmakers take secrecy oaths upon taking office, and they can face internal congressional discipline\u2014including potential expulsion by a two-thirds vote\u2014if they leak classified information.</p>\n<p>WUSA9\n+3\nStaff Are Different: Unlike the members themselves, congressional aides and personal or committee staff do have to go through formal background investigations and obtain security clearances to handle classified files.</p>\n<p>GovExec.com\n+2\nFor further details on how these rules are structured, read the Congressional Research Service FAQ on Security Clearances or examine industry perspectives on Roll Call.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 31, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "DIDN'T\u00a0\u00a0EARN\u00a0\u00a0IT", "archive_id": ""}, {"is_locked": false, "tweet_id": "2118393453016948932", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1AToZ0ySnZ", "is_twitter": true, "is_admin": false, "score": 171, "suggested_sort": 0, "post_flair_class": "", "id": 8926701, "raw_content": "", "author": "KingBasher", "created": 1793970232888, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "MrJinxy", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1AToZ0ySnZ.png", "removal_source": "", "link": "https://twitter.com/AmiriKing/status/2118393453016948932", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Russell Brand now faces spending the rest of his life in prison.", "last_comment_created": 1793994800827, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "