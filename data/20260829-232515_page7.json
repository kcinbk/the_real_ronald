16], "heightRatio": 177, "type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2093668320759144448/vid/avc1/320x568/kU7oIC4NDJTFchu2.mp4"}, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2029102189575094272/AGZs2jAu_normal.jpg", "displayName": "shellshock", "username": "shellshockkk"}, "content": "Everybody\u2019s problem", "parentTweet": false, "likes": 1098}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATV3TKxc5", "is_twitter": false, "is_admin": false, "score": 25, "suggested_sort": 0, "post_flair_class": "", "id": 8806615, "raw_content": "A congressional commission changed military installations named after Confederate leaders. This included renaming Fort Bragg in North Carolina to Fort Liberty in 2023 (though it was later reverted).\n\nPublic Schools: Local school boards across various states have voted to rename schools originally named after historical figures who owned slaves or held racist views, such as George Washington or Thomas Jefferson.City Streets and Parks: Several city councils have removed Confederate names from local parks, streets, and monuments.\n\nQuaker Oats changed the name and logo of Aunt Jemima to remove racial stereotypes. \n\nBen\u2019s Original: Mars changed the name of Uncle Ben's rice to update its branding and imagery.\n\nWhat else can you name?", "author": "Rango", "created": 1788048449008, "profile_picture": "lYqxc7OL9J3P", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Rango", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "President Barack Obama changed the name of Mount McKinley back to Denali in 2015.", "last_comment_created": 1788054123788, "content": "<p>A congressional commission changed military installations named after Confederate leaders. This included renaming Fort Bragg in North Carolina to Fort Liberty in 2023 (though it was later reverted).</p>\n<p>Public Schools: Local school boards across various states have voted to rename schools originally named after historical figures who owned slaves or held racist views, such as George Washington or Thomas Jefferson.City Streets and Parks: Several city councils have removed Confederate names from local parks, streets, and monuments.</p>\n<p>Quaker Oats changed the name and logo of Aunt Jemima to remove racial stereotypes.</p>\n<p>Ben\u2019s Original: Mars changed the name of Uncle Ben's rice to update its branding and imagery.</p>\n<p>What else can you name?</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 7, "score_up": 25, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATV3SCqD1", "is_twitter": false, "is_admin": false, "score": 161, "suggested_sort": 0, "post_flair_class": "", "id": 8805727, "raw_content": "", "author": "rdvs34283", "created": 1788012012443, "profile_picture": "p9HQtdiLq2uP", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "GentleSlayer", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.scored.co", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATV3SCqD1.png", "removal_source": "", "link": "https://media.scored.co/post/nXE0erQNm37V.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/rFfUXaQBGFWWdYod.jpeg", "width": 615, "content-type": "jpeg", "height": 768}], "blurhash": "UQLNurM|_3oL_4odD%WV