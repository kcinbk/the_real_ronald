s_nsfw": false, "is_deleted": false, "is_image": false, "comments": 1, "score_up": 67, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"description": "(The Economic Collapse Blog)\u2014What in the world just happened? Words like \u201ctsunami\u201d and \u201cwipeout\u201d are being used by the pundits,", "large_image": "fM6i4yIGq3bhQDOX.png", "title": "11 Facts About the Midterms That Show That America Is in Far More Trouble Than Most People Realize"}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2118697100980486577", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1AToZ25Dcm", "is_twitter": true, "is_admin": false, "score": 11, "suggested_sort": 0, "post_flair_class": "", "id": 8927190, "raw_content": "", "author": "MrUnderhill", "created": 1793988884604, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Trump454748", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1AToZ25Dcm.png", "removal_source": "", "link": "https://twitter.com/PeterBernegger/status/2118697100980486577?a=in-FIHL2OnhegDR2rUw&s=20", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "\"Ohio Republicans cast more votes for Auditor and Treasurer than their US Senate and Governor seats.\"", "last_comment_created": 1793989641523, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 11, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": [{"width": 738, "heightRatio": 26, "url": "https://pbs.twimg.com/media/HWcfTvgWcAEoPTF.png", "height": 197}], "linkEmbed": false, "replies": 124, "created": 1793971727000, "id": "2118697100980486577", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/1607757622391734274/XMLfShP9_normal.jpg", "displayName": "Peter Bernegger", "username": "PeterBernegger"}, "content": "Election fraud: Ohio Republicans cast more votes for Auditor and Treasurer than their US Senate and Governor seats. Really? I don't think so. \n\nThe pattern continues like Texas and North Carolina (see previous two tweets).\n\n@FSociety_1942 found this unholy pattern, help him out", "parentTweet": false, "likes": 2973}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1AToZ25D9t", "is_twitter": false, "is_admin": false, "score": 14, "suggested_sort": 0, "post_flair_class": "", "id": 8927121, "raw_content": "When last I checked I don't work for leftists or give them aid or comfort. And yet, everytime we hit a speed bump, the right turns on itself like a pack of Jackals. \n\nThe fault is two prong. Obvious fraud not checked by the SAVE act, and an almost precisely predictable habit of the Conservative electorate not getting off their ass and not understanding that the left will not quit until they are completely eradicated.\n\nWe did not have the same \"too big to rig\" energy we did in '24. Conservative voters have the most documentable case of, \"The Fighters Paradox\" I have ever seen.\n\nDo we address this? No. Let's just start infighting, looking for scapegoats, and do our enemy's jobs for them. Because that is always how to get shit done...Right?...\n\n", "author": "Alpha-Kil0", "created": 1793985579414, "profile_picture": "nFm7nABf3gi8", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Iremembermypassword", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Didn't sign up to work for the left...", "last_comment_created": 1793987395496, "content": "<p>When last I checked I don't work for leftists or give them aid or comfort. And yet, everytime we hit a speed bump, the right turns on itself like a pack of Jackals.</p>\n<p>The fault is two prong. Obvious fraud not checked by the SAVE act, and an almost precisely predictable habit of the Conservative electorate not getting off their ass and not understanding that the left will not quit until they are completely eradicated.</p>\n<p>We did not have the same &quot;too big to rig&quot; energy we did in '24. Conservative voters have the most documentable case of, &quot;The Fighters Paradox&quot; I have ever seen.</p>\n<p>Do we address this? No. Let's just start infighting, looking for scapegoats, and do our enemy's jobs for them. Because that is always how to get shit done...Right?...</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 14, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1AToZ25DIE", "is_twitter": false, "is_admin": false, "score": 13, "suggested_sort": 0, "post_flair_class": "", "id": 8927146, "raw_content": "", "author": "Ha_hippopotamus", "created": 1793986860165, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Ha_hippopotamus", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.scored.co", "is_crosspost": false, "preview": "https://media.scored.co/preview/1AToZ25DIE.png", "removal_source": "", "link": "https://media.scored.co/post/0fNGRyNJU57S.jpeg", "author_flair_class": "", "is