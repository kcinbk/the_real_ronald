lair_class": "", "id": 8857618, "raw_content": "", "author": "DT170x", "created": 1790465342636, "profile_picture": "UhXqc82ciZdp", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Inspector_Clouseau", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVQvna6i.png", "removal_source": "", "link": "https://twitter.com/TonySeruga/status/2103957682780885311", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "We just blocked over 65,000 bot farm accounts that were running denial-of-service (DoS/DDoS) attacks against our government clients.\n\nInterestingly, these are the same IP blocks that post social media drivel; they can pivot from one passion to the next in a nanosecond.", "last_comment_created": 1790471387780, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 4, "score_up": 81, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": [{"width": 1085, "heightRatio": 58, "url": "https://pbs.twimg.com/media/HTLA1nfaMAAGacs.jpg", "height": 630}, {"width": 1920, "heightRatio": 46, "url": "https://pbs.twimg.com/media/HTLA36LboAATsho.jpg", "height": 886}, {"width": 2048, "heightRatio": 75, "url": "https://pbs.twimg.com/media/HTLA6uVb0AAxdV3.jpg", "height": 1536}, {"width": 1024, "heightRatio": 75, "url": "https://pbs.twimg.com/media/HTLA-T2aAAAgAlq.jpg", "height": 768}], "linkEmbed": false, "replies": 21, "created": 1790457575000, "id": "2103957682780885311", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2070478338922258433/UUPG17op_normal.jpg", "displayName": "Tony Seruga", "username": "TonySeruga"}, "content": "We just blocked over 65,000 bot farm accounts that were running denial-of-service (DoS/DDoS) attacks against our government clients.\n\nInterestingly, these are the same IP blocks that post social media drivel; they can pivot from one passion to the next in a nanosecond.", "parentTweet": false, "likes": 1254}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVQvnJSR", "is_twitter": false, "is_admin": false, "score": 89, "suggested_sort": 0, "post_flair_class": "", "id": 8857577, "raw_content": "I keep hearing that we control both Houses and the Presidency, only we don't. We control the Presidency and the House, not the Senate. It only looks like we control the Senate because Democrats pretending to be Republicans put a R next to their name. Make no mistake blaming the GOP for not getting stuff done when we never really controlled the Senate in the first place is the mistake and it's one the Democrats want you to make. They want you to think voting Republican means nothing because we can't get anything done even when we control the 3 branches of Government. And here lies the trick... stall and sabotage Trump's agenda from within the GOP and have the voter base turn on them for the midterms so they can't get enough Senators replaced to pass the Save America Act. The truth is we're so close to getting an actual majority in the Senate to get rid of the filibuster and pass the Save America Act. The House has been mostly drained of the Swamp, Trump is continuing to drain the Federal Government of the Swamp, but the Senate needs to be replaced with patriots... they have 6 year terms so we haven't been able to replace enough of them yet. This year we can since most of the never Trumpers got voted out or are retiring. Don't give up on the eve of victory. ", "author": "Will-Not-Comply", "created": 1790463344213, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "GA_Logic", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "You guys actually think we control the Senate don't you? Blaming the GOP for not passing the Save America Act when we control 3 branches of government? Well we don't and it's blatantly obvious. ", "last_comment_created": 1790478013082, "content": "<p>I keep hearing that we control both Houses and the Presidency, only we don't. We control the Presidency and the House, not the Senate. It only looks like we control the Senate because Democrats pretending to be Republicans put a R next to their name. Make no mistake blaming the GOP for not getting stuff done when we never really controlled the Senate in the first place is the mistake and it's one the Democrats want you to make. They want you to think voting Republican means nothing because we can't get anything done even when we control the 3 branches of Government. And here lies the trick... stall and sabotage Trump's agenda from within the GOP and have the voter base turn on them for the midterms so they can't get enough Senators replaced to pass the Save America Act. The truth is we're so close to getting an actual majority in the Senate to get rid of the filibuster and pass the Save America Act. The House has been mostly drained of the Swamp, Trump is continuing to drain the Federal Government of the Swamp, but the Senate needs to be replaced with patriots... they have 6 year terms so we haven't been able to replace enough of them yet. This year we can since most of the never Trumpers got voted out or are retiring. Don't give up on the eve of victory.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 11, "score_up": 89, "is_e