se, "likes": 4379}, "images": [{"width": 1200, "heightRatio": 91, "url": "https://pbs.twimg.com/media/HOFS4pjW8AAg2T1.jpg", "height": 1100}], "linkEmbed": false, "replies": 0, "created": 1785073800000, "id": "2081376491225612520", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2064951015330439168/p9Uqu7gw_normal.jpg", "displayName": "LayoffHedge", "username": "LayoffAI"}, "content": "H-1B workers (Indians the largest group) poured into a handful of tech metros during the 2020\u20132022 boom and bought homes with 30-year mortgages.  \n\nThose same cities (red and orange on the map) are now seeing the steepest price crashes as that demand reverses.", "parentTweet": false, "likes": 1347}, "likes": 18}}, "post_flair_text": "", "archive_id": ""}], "status": true}