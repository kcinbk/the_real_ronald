r": "the-new-style", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATC9LK44P.png", "removal_source": "", "link": "https://twitter.com/RedPillRabbit/status/2084108353718845851?s=20", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Get yourself a white doctor", "last_comment_created": 1785758109062, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 8, "score_up": 202, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": [{"width": 1290, "heightRatio": 123, "url": "https://pbs.twimg.com/media/HOw9gHyWYAAPUMe.jpg", "height": 1590}], "linkEmbed": false, "replies": 4, "created": 1785725127000, "id": "2084108353718845851", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2011574641786306562/Rq8L1qWc_normal.jpg", "displayName": "Neon White Rabbit", "username": "RedPillRabbit"}, "content": "There are countless fake Indian medical professionals operating in the US right now.", "parentTweet": false, "likes": 61}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATC9LLASv", "is_twitter": false, "is_admin": false, "score": 38, "suggested_sort": 0, "post_flair_class": "deport", "id": 8761441, "raw_content": "You add the \"&udm=14\" to the end of your query and it will go back to normal pre AI summary google with traditional results\n\n---\nExample \n\n* https://www.google.com/search?q=test&udm=14\n\n---\nSo in brave/chrome you add a new search engine because you can't mod the original google search engine entry.  I did 'goog2' and then put in the above link, and %s for the query string\n\n* https://www.google.com/search?q=%s&udm=14\n\n---\nScreenshot of Gemini spilling beans\n\nhttps://files.catbox.moe/dudvvv.jpg", "author": "5DchessWatch", "created": 1785767928195, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "ActNow", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Google's AI Gemini spilled the beans on a secret setting that lets you go back to traditional search without the AI summary", "last_comment_created": 1785777788221, "content": "<p>You add the &quot;&amp;udm=14&quot; to the end of your query and it will go back to normal pre AI summary google with traditional results</p>\n<hr />\n<p>Example</p>\n<ul>\n<li><a rel=\"nofollow\" href=\"https://www.google.com/search?q=test&amp;udm=14\" target=\"_blank\">https://www.google.com/search?q=test&amp;udm=14</a></li>\n</ul>\n<hr />\n<p>So in brave/chrome you add a new search engine because you can't mod the original google search engine entry.  I did 'goog2' and then put in the above link, and %s for the query string</p>\n<ul>\n<li><a rel=\"nofollow\" href=\"https://www.google.com/search?q=%s&amp;udm=14\" target=\"_blank\">https://www.google.com/search?q=%s&amp;udm=14</a></li>\n</ul>\n<hr />\n<p>Screenshot of Gemini spilling beans</p>\n<p><a rel=\"nofollow\" href=\"https://files.catbox.moe/dudvvv.jpg\" target=\"_blank\">https://files.catbox.moe/dudvvv.jpg</a></p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 10, "score_up": 38, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "DEPORT", "archive_id": ""}, {"is_locked": 