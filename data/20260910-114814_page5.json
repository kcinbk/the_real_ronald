content": "", "author": "KredibilityKrisis", "created": 1789041332033, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "KredibilityKrisis", "is_video": false, "video_link": "", "is_new_user": false, "domain": "nypost.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVCrmkWj.png", "removal_source": "", "link": "https://nypost.com/2026/09/10/business/hunter-bidens-meme-coin-crushed-4-out-of-5-buyers-while-one-mystery-trader-raked-in-1m/", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Hunter Biden\u2019s meme coin crushed 4 out of 5 buyers while one mystery trader raked in $1M: \u2018classic rug pull\u2019", "last_comment_created": 1789043470147, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 8, "score_up": 41, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"description": "Four out of five people who bought into Hunter Biden\u2019s new meme coin saw their investments go up in smoke during the cryptocurrency\u2019s spectacular launch-day collapse", "large_image": "XswseQ6P4Zvn1wng.png", "title": "Exclusive | Hunter Biden\u2019s meme coin crushed 4 out of 5 buyers while one mystery trader raked in $1M: \u2018classic rug pull\u2019"}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVCrmkWe", "is_twitter": false, "is_admin": false, "score": 41, "suggested_sort": 0, "post_flair_class": "", "id": 8827240, "raw_content": "Turning Point USA has experienced unprecedented growth following the loss of founder Charlie Kirk in September 2025, becoming the fastest-growing conservative youth organization in the U.S. With the leadership of Erika Kirk, the group has significantly expanded its footprint on high school and college campuses, cementing its influence in Republican politics. \r\n\r\n**Key Growth Metrics**:\r\n\r\n**High School Expansion**: The organization now has 3,500 Club America high school clubs nationwide, a 180% increase from the previous school year, with 500 chapters specifically in Texas high schools. \r\n\r\n**College Presence**: There are over 1,500 college chapters, representing a 64% increase, with more than 70% of active college chapters established after Kirk\u2019s death. \r\n\r\n**Membership Surge**: Chapters report massive enrollment jumps, such as the University of Oklahoma\u2019s chapter growing from 15 to 2,000 members and Indiana University\u2019s tripling to 363 members. \r\n\r\n**National Reach**: The organization now serves more than one million students and has added over 1,200 employees, with its workforce nearly doubling in size. ", "author": "Bullet3250", "created": 1789040966948, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "KeKeKeKeK3621", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Hey Grok: How is TPUSA doing these days??  Turning Point USA has experienced unprecedented growth following the loss of founder Charlie Kirk in September 2025, becoming the fastest-growing conservative youth organization in the U.S.", "last_comment_created": 1789049950975, "content": "<p>Turning Point USA has experienced unprecedented growth following the loss of founder Charlie Kirk in September 2025, becoming the fastest-growing conservative youth organization in the U.S. With the leadership of Erika Kirk, the group has significantly expanded its footprint on high school and college campuses, cementing its influence in Republican politics.</p>\n<p><strong>Key Growth Metrics</strong>:</p>\n<p><strong>High School Expansion</strong>: The organization now has 3,500 Club America high school clubs nationwide, a 180% increase from the previous school year, with 500 chapters specifically in Texas high schools.</p>\n<p><strong>College Presence</strong>: There are over 1,500 college chapters, representing a 64% increase, with more than 70% of active college chapters established after Kirk\u2019s death.</p>\n<p><strong>Membership Surge</strong>: Chapters report massive enrollment jumps, such as the University of Oklahoma\u2019s chapter growing from 15 to 2,000 members and Indiana University\u2019s tripling to 363 members.</p>\n<p><strong>National Reach</strong>: The organization now serves more than one million students and has added over 1,200 employees, with its workforce nearly doubling in size.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 12, "score_up": 41, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVCrn1uQ", "is_twitter": false, "is_admin": false, "score": 27, "suggested_sort": 0, "post_flair_class": "", "id": 8827396, "raw_content": "", "author": "China4Biden", "created": 1789049053047, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "MatterThatMetals", "is_video": false, "video_link": "", "is_new_user": false, "domain": "rumble.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVCrn1uQ.png", "removal_source": "", "link": "https://rumble.com/v73bnws-india-isnt-sending-their-best-an-h1-b-indian-nurse-is-caught-shoplifting-fr.html", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": ""