_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVQtWWLm", "is_twitter": false, "is_admin": false, "score": 9, "suggested_sort": 0, "post_flair_class": "", "id": 8855566, "raw_content": "I took the refund.  They had charged an additional $612 for shipping.  Then found another from out of state.  Items no long available.\n\nOrdered from online and it clearly states Made in China.  Not in stock in USA.  I ordered these items anyway, since they were $2280 cheaper and I don't care anymore if they are high quality.  Just need to finish rental remodel.\n\nOrdered on Sept.23, 2026, shipped from China to Romeville, Ill. the next day.  LOL.  https://files.catbox.moe/fbt217.JPG  All were free shipping, total weight of 7 boxed packages is 590 lbs.\n\nThen after ordering, I read 107 reviews and all said 5 stars, it was high quality, durable, easy to assemble, exceeded expectations, and they posted pictures.  \n\nThis is how we are losing in the free market.  \n\nIn August I order items from Seattle Wa.  It was only $26 worth of clips, rollers and hardware.  It never came, they refund my money.  Did not ask if I wanted another order sent, just refund the money.", "author": "OrangeManNotBad", "created": 1790350566769, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "OrangeManNotBad", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Ordered cabinets and wardrobes to be made close to home here.  16 week wait.  Then notice was sent the wait is longer.  Option to cancel for full refund.", "last_comment_created": 1790352719003, "content": "<p>I took the refund.  They had charged an additional $612 for shipping.  Then found another from out of state.  Items no long available.</p>\n<p>Ordered from online and it clearly states Made in China.  Not in stock in USA.  I ordered these items anyway, since they were $2280 cheaper and I don't care anymore if they are high quality.  Just need to finish rental remodel.</p>\n<p>Ordered on Sept.23, 2026, shipped from China to Romeville, Ill. the next day.  LOL.  <a rel=\"nofollow\" href=\"https://files.catbox.moe/fbt217.JPG\" target=\"_blank\">https://files.catbox.moe/fbt217.JPG</a>  All were free shipping, total weight of 7 boxed packages is 590 lbs.</p>\n<p>Then after ordering, I read 107 reviews and all said 5 stars, it was high quality, durable, easy to assemble, exceeded expectations, and they posted pictures.</p>\n<p>This is how we are losing in the free market.</p>\n<p>In August I order items from Seattle Wa.  It was only $26 worth of clips, rollers and hardware.  It never came, they refund my money.  Did not ask if I wanted another order sent, just refund the money.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 7, "score_up": 9, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVQtWW14", "is_twitter": false, "is_admin": false, "score": 10, "suggested_sort": 0, "post_flair_class": "", "id": 8855512, "raw_content": "", "author": "HowCome", "created": 1790348452485, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "ErikaLives", "is_video": false, "video_link": "", "is_new_user": false, "domain": "nationalpost.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVQtWW14.png", "removal_source": "", "link": "https://nationalpost.com/opinion/terr