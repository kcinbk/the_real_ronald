mp4": false, "type": "link", "uuid": "1ATon64fxf", "is_twitter": false, "is_admin": false, "score": 20, "suggested_sort": 0, "post_flair_class": "", "id": 8957067, "raw_content": "", "author": "Moebius", "created": 1795761972863, "profile_picture": "0F9hm63l5dUw", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "BBvarn", "is_video": false, "video_link": "", "is_new_user": false, "domain": "www.armyrecognition.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATon64fxf.png", "removal_source": "", "link": "https://www.armyrecognition.com/news/army-news/2026/us-army-declares-first-dark-eagle-hypersonic-missile-battery-ready-for-global-deployment", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "US Army Declares First Dark Eagle Hypersonic Missile Battery Ready for Global Deployment.", "last_comment_created": 1795775584136, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 4, "score_up": 20, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"description": "The US Army fields its first Dark Eagle hypersonic missile battery with a 2775 km range after three years of delays, enabling global operational deployment.", "large_image": "eQM3el7SKPrkyHco.png", "title": "US Army Declares First Dark Eagle Hypersonic Missile Battery Ready for Global Deployment"}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2126239035429646498", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATon64wsK", "is_twitter": true, "is_admin": false, "score": 10, "suggested_sort": 0, "post_flair_class": "", "id": 8957140, "raw_content": "", "author": "raptoris", "created": 1795775446283, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "2EyesOpen", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATon64wsK.png", "removal_source": "", "link": "https://twitter.com/Osint613/status/2126239035429646498", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Commander of the Islamic Republic of Iran Navy claims the U.S. military stole two Iranian oil tankers, but the Navy\u2019s commandos went aboard them while the Americans were asleep and retook the vessels.", "last_comment_created": 1795781507181, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 10, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": false, "linkEmbed": false, "replies": 57, "created": 1795769864000, "id": "2126239035429646498", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2094762039746936832/f8vexHZ2_normal.jpg", "displayName": "Open Source Intel", "username": "Osint613"}, "content": "Commander of the Islamic Republic of Iran Navy claims the U.S. military stole two Iranian oil tankers, but the Navy\u2019s commandos went aboard them while the Americans were asleep and retook the vessels.", "parentTweet": false, "likes": 272}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATon65DnA", "is_twitter": false, "is_admin": false, "score": 7, "suggested_sort": 0, "post_flair_class": "", "id": 8957224, "raw_content": "Jan 8 \u2013 OSA expanded to mandate preemptive AI scanning of private messages (cyberflashing, self-harm content) before delivery\n\nApr 7 \u2013 Duty to report detected child exploitation content to the NCA for messaging services\n\nJun 8 \u2013 Starmer gave Apple and Google three months to build on-device nude-image scanning into every phone, or face legislation\n\nJun 15 \u2013 Under-16 social media ban announced, regulations expected by end of 2026, in force spring 2027\n\nJul 8 \u2013 National Security (State Threats) Act received royal assent\n\nNov 4 \u2013 Home Office confirmed a national facial recognition framework with a dedicated watchdog; Met Police had already run 1.7 million LFR face-matching searches in 2025 alone\n\nNov 25 \u2013 Knife licensing confirmed, covering all knives including butter knives, for businesses and private sellers alike \u2060\n\nThe pace of new mandates per quarter is noticeably steeper than 2024\u201325, and the scope keeps broadening from \"obviously dangerous\" to \"technically possible.\" The device-level scanning proposal is probably the clearest example of the ratchet effect...once you've normalized that the state can compel a phone manufacturer to scan every image on a phone, the next ask is harder to resist.", "author": "CommieCucker", "created": 1795782393375, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "CommieCucker", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "UK government is accelerating", "last_comment_created": 1795783861775, "content": "<p>Jan 8 \u2013 OSA expanded to mandate preemptive AI scanning of private messages (cyberflashing, self-harm content) before delivery</p>\n<p>Apr 7 \u2013 Duty to report detected child exploitation content to the NCA for messaging services</p>\n<p>Jun 8 \u2013 Starmer gave Apple and Google three months to build on-device nude-image scanning into every phone, or face legislation</p>\n<p>Jun 15 \u2013 Under-16 social media ban announced, regulations expected by end of 2026, in force spring 2027</p>\n<p>Jul 8 \u2013 National Security (State Threats) Act received royal assent</p>\n<p>Nov 4 \u2013 Home Office confirmed a national facial recognition framework with a dedicated watchdog; Met Police had already run 1.7 million LFR face-matching searches in 2025 alone</p>\n<p>Nov 25 \u2013 Knife licensing confirmed, covering all knives including butter knives, for businesses and private sellers alike \u2060</p>\n<p>The pace of new mandates per quarter is noticeably steeper than 2024\u201325, and the scope keeps broadening from &quot;obviously dangerous&quot; to &quot;technically possible.&quot; The device-level scanning proposal is probably the clearest example of the ratchet effect...once you've normalized that the state can compel a phone manufacturer to scan every image on a phone, the next ask is harder to resist.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 3, "score_up": 7, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATon64g1p", "is_twitter": false, "is_admin": false, "score": 18, "suggested_sort": 0, "post_flair_class": "", "id": 8957079, "raw_content": "", "author": "raptoris", "created": 1795763745188, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "SnowSnake", "is_video": false, "video_link": "", "is_new_user": false, "domain": "archive.ph", "is_crosspost": false, "preview": "", "removal_source": "", "link": "https://archive.ph/5pWto", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Iranians\u2019 frustrations grow as T