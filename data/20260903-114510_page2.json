_source": "", "link": "https://media.patriots.win/post/4DILBLPqZCXW.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/0Xw87SR3SFPDtYpf.jpeg", "width": 768, "content-type": "jpeg", "height": 586}], "blurhash": "UHM7u;IUj[~q00IUM{IUt7IUWBj[t7%MM{%M", "full_resolution": [672, 880]}, "title": "This is a sanctuary state*", "last_comment_created": 1788439062726, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 1, "score_up": 80, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2095227476473438706", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATV87jy8H", "is_twitter": true, "is_admin": false, "score": 64, "suggested_sort": 0, "post_flair_class": "", "id": 8814859, "raw_content": "", "author": "Belleoffreedom", "created": 1788438900423, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Mestroisfils", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATV87jy8H.png", "removal_source": "", "link": "https://twitter.com/KamVTV/status/2095227476473438706?s=20", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "\n\nKambree\n@KamVTV\n\u00b7\n17h\nThe New York Times just exposed James Talarico\u2019s entire campaign: he\u2019s paying influencers for fake support.", "last_comment_created": 1788449222868, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 6, "score_up": 64, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": false, "linkEmbed": false, "replies": 380, "created": 1788376132000, "id": "2095227476473438706", "video": {"preview": "https://pbs.twimg.com/amplify_video_thumb/2095227226929131526/img/GtODyVQAX2YEI0IC.jpg", "mpeg": "https://video.twimg.com/amplify_video/2095227226929131526/pl/nag4umgwtJ4NWvY_.m3u8?v=0f2", "aspectRatio": [9, 16], "heightRatio": 177, "type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2095227226929131526/vid/avc1/320x568/9JbDq3YXnhIUgjKt.mp4"}, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2086903779199266817/j7meAx49_normal.jpg", "displayName": "Kambree", "username": "KamVTV"}, "content": "The New York Times just exposed James Talarico\u2019s entire campaign: he\u2019s paying influencers for fake support.", "parentTweet": false, "likes": 6568}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATV87kFJW", "is_twitter": false, "is_admin": false, "score": 52, "suggested_sort": 0, "post_flair_class": "god", "id": 8814976, "raw_content": "My apologies. This site has sort of become a place for me to get things off my chest as I navigate life with cancer. \n\nI've had a double mastectomy and radiation treatments. I have developed mild lymphedema. Started back on endocrine therapy for preventive care about 2 weeks ago and had to cancel my appointment with lymphedema specialist this week bc I was too sick from the medications I'm on to even drive. I ended up sleeping 16 hours yesterday. There is only one specialist within driving distance for me and I could not get to that appt. So, I'm using internet research to treat it myself. \n\nI've decided I'm not willing to continue the meds my oncologist wants me to take that would help prevent recurrence. I'm miserable. My body hurts all over. I feel like I imagine a 100 year old would feel and I'm only 54. My mind is young still. There are things I want to do beyond laying in bed, pooping all the time, being so nauseated nothing is appetizing, having no energy to even talk on the phone. My appetite is so bad the only food I can stand is crackers or rice or potatoes. I don't even have the energy to take a bath. \n\nI have no interest in living this way. I'd rather have 2-3 good years of enjoying whatever life I have left than 10 years laying in bed wishing I were dead. \n\nI guess I'm posting this here bc I'm open to other perspectives. Please no more suggestions about ivermectin and fenben. Am I crazy to stop all meds and just let nature take its course? I feel as if I should have been dead already. My body is breaking down and I'm suffering by trying to keep it together. \n\nI'll take all the prayers I can get as I go forward. I'm going to put all my worries, concerns, pains, illness, all of it in God's hands. Let his wll be done. ", "author": "ChickNorris", "created": 1788442892822, "profile_picture": "Qe8wSmir2i1S", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "LaptopDied", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Stopping Cancer Treatment - sort of", "last_comment_created": 1788450185014, "content": "<p>My apologies. This site has sort of become a place for me to get things off my chest as I navigate life with cancer.</p>\n<p>I've had a double mastectomy and radiation treatments. I have developed mild lymphedema. Started back on endocrine therapy for preventive care about 2 weeks ago and had to cancel my appointment with lymphedema specialist this week bc I was too sick from the medications I'm on to even drive. I ended up sleeping 16 hours yesterday. There is only one specialist within driving distance for me and I could not get to that appt. So, I'm using internet research to treat it myself.</p>\n<p>I've decided I'm not willing to continue the meds my oncologist wants me to take that would help prevent recurrence. I'm miserable. My body hurts all over. I feel like I imagine a 100 year old would feel and I'm only 54. My mind is young still. There are things I want to do beyond laying in bed, pooping all the time, being so nauseated nothing is appetizing, having no energy to even talk on the phone. My appetite is so bad the only food I can stand is crackers or rice or potatoes. I don't even have the energy to take a bath.</p>\n<p>I have no interest in living this way. I'd rather have 2-3 good years of enjoying whatever life I have left than 10 years laying in bed wishing I were dead.</p>\n<p>I guess I'm posting this here bc I'm open to other perspectives. Please no more suggestions about ivermectin and fenben. Am I crazy to stop all meds and just let nature take its course? I feel as if I should have been dead already. My body is breaking down and I'm suffering by trying to keep it together.</p>\n<p>I'll take all the prayers I can get as I go forward. I'm going to put all my worries, concerns, pains, illness, all of it in God's hands. Let his wll be done.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 23, "score_up": 52, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "\u271d\ufe0f\u00a0\u00a0\u00a0UNDER GOD\u00a0\u00a0\u00a0\u271d\ufe0f", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATV87jh5F", "is_twitter": false, "is_admin": false, "score": 79, "suggested_sort": 0, "post_flair_class": "", "id": 8814759, "raw_content": "", "author": "Poobah", "created": 1788434687425, "profile_picture":