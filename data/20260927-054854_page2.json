ore_up": 520, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0PEPE\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVQwuKfM", "is_twitter": false, "is_admin": false, "score": 30, "suggested_sort": 0, "post_flair_class": "", "id": 8858064, "raw_content": "", "author": "HighRollerHenry", "created": 1790493157217, "profile_picture": "2Mz5StukaCwG", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "HighRollerHenry", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.scored.co", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVQwuKfM.png", "removal_source": "", "link": "https://media.scored.co/post/8JG2aKQ0RKeB.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/BdgULyXkRnPjhhcu.png", "width": 768, "content-type": "png", "height": 690}], "blurhash": "U7Bg9=~Dt8K4D+InRjr?00yCfP%2tJQ.xbXR", "full_resolution": [790, 879]}, "title": "\"It ain't much, but it's honest work.\" \ud83d\ude0e", "last_comment_created": 1790498256126, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 5, "score_up": 30, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVQvnJSR", "is_twitter": false, "is_admin": false, "score": 135, "suggested_sort": 0, "post_flair_class": "", "id": 8857577, "raw_content": "I keep hearing that we control both Houses and the Presidency, only we don't. We control the Presidency and the House, not the Senate. It only looks like we control the Senate because Democrats pretending to be Republicans put a R next to their name. Make no mistake blaming the GOP for not getting stuff done when we never really controlled the Senate in the first place is the mistake and it's one the Democrats want you to make. They want you to think voting Republican means nothing because we can't get anything done even when we control the 3 branches of Government. And here lies the trick... stall and sabotage Trump's agenda from within the GOP and have the voter base turn on them for the midterms so they can't get enough Senators replaced to pass the Save America Act. The truth is we're so close to getting an actual majority in the Senate to get rid of the filibuster and pass the Save America Act. The House has been mostly drained of the Swamp, Trump is continuing to drain the Federal Government of the Swamp, but the Senate needs to be replaced with patriots... they have 6 year terms so we haven't been able to replace enough of them yet. This year we can since most of the never Trumpers got voted out or are retiring. Don't give up on the eve of victory. ", "author": "Will-Not-Comply", "created": 1790463344213, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "GA_Logic", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "You guys actually think we control the Senate don't you? Blaming the GOP for not passing the Save America Act when we control 3 branches of government? Well we don't and it's blatantly obvious. ", "last_comment_created": 1790478013082, "content": "<p>I keep hearing that we control both Houses and the Presidency, only we don't. We control the Presidency and the House, not the Senate. It only looks like we control the Senate because Democrats pretending to be Republicans put a R next to their name. Make no mistake blaming the GOP for not getting stuff done when we never really controlled the Senate in the first place is the mistake and it's one the Democrats want you to make. They want you to think voting Republican means nothing because we can't get anything done even when we control the 3 branches of Government. And here lies the trick... stall and sabotage Trump's agenda from within the GOP and have the voter base turn on them for the midterms so they can't get enough Senators replaced to pass the Save America Act. The truth is we're so close to getting an actual majority in the Senate to get rid of the filibuster and pass the Save America Act. The House has been mostly drained of the Swamp, Trump is continuing to drain the Federal Government of the Swamp, but the Senate needs to be replaced with patriots... they have 6 year terms so we haven't been able to replace enough of them yet. This year we can since most of the never Trumpers got voted out or are retiring. Don't give up on the eve of victory.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 11, "score_up": 135, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2104003824570503367", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVQvnrM1", "is_twitter": true, "is_admin": false, "score": 90, "suggested_sort": 0, "post_flair_class": "", "id": 8857741, "raw_content": "", "author": "kinbergfan", "created": 1790471207924, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "ancroidubh", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.c