683}], "linkEmbed": false, "replies": 32, "created": 1784939043000, "id": "2080811281238335491", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2014596506766934016/rYKFfyx8_normal.jpg", "displayName": "SCOTUS Wire", "username": "scotus_wire"}, "content": "\ud83d\udea8 A federal judge has struck down Illinois laws allowing unlawfully present aliens to receive in-state college tuition, state financial aid, and DREAM Act scholarship benefits, ruling those laws are preempted by federal immigration law.", "parentTweet": false, "likes": 2345}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATC01Qy6D", "is_twitter": false, "is_admin": false, "score": 694, "suggested_sort": 0, "post_flair_class": "poopy", "id": 8744881, "raw_content": "", "author": "TEXinLA", "created": 1784903483925, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "AmericanJawa", "is_video": false, "video_link": "", "is_new_user": false, "domain": "pjmedia.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATC01Qy6D.png", "removal_source": "", "link": "https://pjmedia.com/stephen-kruiser/2026/07/22/rudderless-dems-keep-sending-gift-horses-for-gop-to-look-in-the-mouth-n4955347", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Rudderless Dems Keep Sending Gift Horses for GOP to Look in the Mouth", "last_comment_created": 1784943394801, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 53, "score_up": 694, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"description": "Analysis of Democratic Party struggles and GOP opportunities ahead of 2026 midterms.", "large_image": "WSSpXOcwBq8xp8z3.png", "title": "Rudderless Dems Keep Sending Gift Horses for GOP to Look in the Mouth"}, "post_flair_text": "\ud83d\udca9\u00a0\u00a0POOPY\u00a0\u00a0DAYS", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATC02Z52X", "is_twitter": false, "is_admin": false, "score": 92, "suggested_sort": 0, "post_flair_class": "", "id": 8745709, "raw_content": "Even if you're not white, this is proof positive that laws do not matter in this country anymore (as if we needed more proof). It is proof that white people are second-class citizens in the nation their ancestors built, just like in Europe where their ancestors were from. Our government was never set up to handle this turn of events. Any move it makes to right the wrongs will be used to push that much harder for the entrenchment of our second class status. This will only get worse. Every white (and culturally white person) needs to start getting used to the idea that you're going to be forced into violence. Maybe not tomorrow, but some day soon. When there is a breakdown in law and order, due to literally any reason, know that everyone else believes in the \"us vs everyone who isn't us\" line of tribal thinking, and the way they will figure out who isn't them is ALWAYS based on race. If you see someone 100 yards away and can identify nothing about them but their race, and you are armed and they are armed, it's going to come down to who makes that identification first. Because you can't afford to wait until you can figure out their worldview to see if they're a threat to you, and neither can they. Those with tribalistic cultures inherently know this, so it's time white people remember the days when tribalism was a survival necessity. Don't get caught unprepared to fight for your life and the life of your family.", "author": "DepartmentOfOffense", "created": 1784942009490, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Counterwhat", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "We are All Shiloh", "last_comment_created": 1784969793067, "content": "<p>Even if you're not white, this is proof positive that laws do not matter in this country anymore (as if we needed more proof). It is proof that white people are second-class citizens in the nation their ancestors built, just like in Europe where their ancestors were from. Our government was never set up to handle this turn of events. Any move it makes to right the wrongs will be used to push that much harder for the entrenchment of our second class status. This will only get worse. Every white (and culturally white person) needs to start getting used to the idea that you're going to be forced into violence. Maybe not tomorrow, but some day soon. When there is a breakdown in law and order, due to literally any reason, know that everyone else believes in the &quot;us vs everyone who isn't us&quot; line of tribal thinking, and the way they will figure out who isn't them is ALWAYS based on race. If you see someone 100 yards away and can identify nothing about them but their race, and you are armed and they are armed, it's going to come down to who makes that identification first. Because you can't afford to wait until you can figure out their worldview to see if they're a threat to you, and neither can they. Those with tribalistic cultures inherently know this, so it's time white people remember the days when tribalism was a survival necessity. Don't get caught unprepared to fight for your life and the life of your family.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 