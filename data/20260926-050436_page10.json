zTfBldDMSC4o.jpg", "mpeg": "https://video.twimg.com/amplify_video/2103467508204240896/pl/RpbgTSSN3uQJ9Ax9.m3u8?v=cfc", "aspectRatio": [16, 9], "heightRatio": 56, "type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2103467508204240896/vid/avc1/480x270/ofAgNtz-1c4Mekev.mp4"}, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2022081822990249994/q5WGacWd_normal.jpg", "displayName": "Dan Scavino Jr.\ud83c\uddfa\ud83c\uddf8\ud83e\udd85", "username": "DanScavino"}, "content": "Truly unbelievable\u2014Here\u2019s another behind the scenes of last nights State Dinner at the @WhiteHouse\u2026", "parentTweet": false, "likes": 6207}}, "post_flair_text": "\ud83e\udde0\u00a0\u00a0STABLE GENIUS\u00a0\u00a0\ud83e\udde0", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVQudXMH", "is_twitter": false, "is_admin": false, "score": 50, "suggested_sort": 0, "post_flair_class": "", "id": 8856021, "raw_content": "Drexel University is intending to close and destroy the Philadelpha Academy of Natural Sciences on September 30th. The museum was founded in 1812 and is the oldest natural science museum in the Americas and holds many historic collections including the plant and animal specimens by the Lewis and Clark Expedition and archeological and paleontological digs by Thomas Jefferson. It houses many dinosaur bone collections and exhibits, including the world's first mounted dinosaur skeleton.\r\n\r\nI hope many others on this website are as concerned as I am about preserving American history and scientific accomplishment as I am and will help support keeping this historical American Museum open.\r\n\r\nMore info here: https://save-the-academy.org", "author": "the_malcontent", "created": 1790373009288, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Deplora", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Drexel University Destroying Historic American Museum", "last_comment_created": 1790373738891, "content": "<p>Drexel University is intending to close and destroy the Philadelpha Academy of Natural Sciences on September 30th. The museum was founded in 1812 and is the oldest natural science museum in the Americas and holds many historic collections including the plant and animal specimens by the Lewis and Clark Expedition and archeological and paleontological digs by Thomas Jefferson. It houses many dinosaur bone collections and exhibits, including the world's first mounted dinosaur skeleton.</p>\n<p>I hope many others on this website are as concerned as I am about preserving American history and scientific accomplishment as I am and will help support keeping this historical American Museum open.</p>\n<p>More info here: <a rel=\"nofollow\" href=\"https://save-the-academy.org\" target=\"_blank\">https://save-the-academy.org</a></p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 4, "score_up": 50, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2103313556167110986", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVQtWW9Q", "is_twitter": true, "is_admin": false, "score": 164, "suggested_sort": 0, "post_flair_class": "", "id": 8855538, "raw_content": "", "author": "Losferwords", "created": 1790349618243, "profile_picture": "haBjxkTTIvRV", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "QSWO1", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": f