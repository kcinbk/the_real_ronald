eo_mp4": false, "type": "link", "uuid": "1ATVQtWW9N", "is_twitter": false, "is_admin": false, "score": 11, "suggested_sort": 0, "post_flair_class": "", "id": 8855535, "raw_content": "", "author": "Alpha-Kil0", "created": 1790349507966, "profile_picture": "nFm7nABf3gi8", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Steve56775", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.scored.co", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVQtWW9N.png", "removal_source": "", "link": "https://media.scored.co/post/BpK7pJVatC9W.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/Y5mtT2vqI9EB9uTV.jpeg", "width": 768, "content-type": "jpeg", "height": 384}], "blurhash": "USShJYj[+pj?jFfQkCfQ*JfQHrf6offQaffQ", "full_resolution": [992, 1984]}, "title": "Canadian Prime Minister Mark Carney announces new flag design...", "last_comment_created": 1790350222412, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 1, "score_up": 11, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVQtWFR1", "is_twitter": false, "is_admin": false, "score": 12, "suggested_sort": 0, "post_flair_class": "", "id": 8855487, "raw_content": "From what I'm hearing, and have to some degree personally observed, a lot of gays here in NYC (and this is probably mainly older gays)  just want to maintain their hard-won rights of equality to everyone else, and aren't trying to support all the ridiculous trans stuff. They are either dismissive of it or upset that the trans activist movement are hijacking all their good work to become accepted in society, and they realize that the trans activists are undermining what they have achieved and are turning normal people against them. It's impossible to quantify but I'm guessing that it is either a very significant amount of gays, or at least this sentiment is growing. The thing is, it is still something hard to talk about on social media etc. because you'll get attacked by the trans-fascist community. ", "author": "ahamrbond", "created": 1790347770447, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "imnotdeadyet", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "I'm in NYC. I'm hearing a lot of gays here are pissed at the transgender movement.", "last_comment_created": 1790349921053, "content": "<p>From what I'm hearing, and have to some degree personally observed, a lot of gays here in NYC (and this is probably mainly older gays)  just want to maintain their hard-won rights of equality to everyone else, and aren't trying to support all the ridiculous trans stuff. They are either dismissive of it or upset that the trans activist movement are hijacking all their good work to become accepted in society, and they realize that the trans activists are undermining what they have achieved and are turning normal people against them. It's impossible to quantify but I'm guessing that it is either a very significant amount of gays, or at least this sentiment is growing. The thing is, it is still something hard to talk about on social media etc. because you'll get attacked by the trans-fascist community.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 10, "score_up": 12, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state":