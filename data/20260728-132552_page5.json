": false, "domain": "cdn.5mind.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATC4efMyX.png", "removal_source": "", "link": "https://cdn.5mind.com/uploads/production/iNaoMml8NiD0ohWeOWB88/image/3pDYm8-E5ARZ_-rpYi3lJ.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/J5P3nCjk1kH60UtF.jpeg", "width": 479, "content-type": "jpeg", "height": 768}], "blurhash": "UjPskrD%?cX8_NxuD%jFW?kCn$aeR5Rio#WW", "full_resolution": [1391, 868]}, "title": "Shit we already knew for $1000 Alex", "last_comment_created": 1785252652777, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 5, "score_up": 41, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATC4dYtzo", "is_twitter": false, "is_admin": false, "score": 72, "suggested_sort": 0, "post_flair_class": "", "id": 8750944, "raw_content": "They buy it the first time via taxes, when the store purchases it to put on the shelves with the taxes they paid. They just shifted the cost from the grocery bill to the tax bill.\n\nWhen they buy it from the store, they're really buying it the second time.\n\nThen when someone uses EBT to buy it, you've buying it TWICE with your taxes, without even getting it.\n\nIf someone uses EBT or theft to get the food, then sells it on the street or to a bodega to resell, congratulations moron, you've bought it thee times.\n\nThe purpose is clearly not to reduce the cost of food.\n\nPS: There will also be runs on the stores, and the food then resold to bodegas or sold on the street. You'll have to get the food that way because the Mamdani shops will have been emptied out by the ghetto speculators.", "author": "Herpawinski", "created": 1785235689502, "profile_picture": "GCJCeufYDd47", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Oodles", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Food in the Mamdani stores isn't cheaper. It's 2x more expensive because the morons are buying it twice.", "last_comment_created": 1785248882451, "content": "<p>They buy it the first time via taxes, when the store purchases it to put on the shelves with the taxes they paid. They just shifted the cost from the grocery bill to the tax bill.</p>\n<p>When they buy it from the store, they're really buying it the second time.</p>\n<p>Then when someone uses EBT to buy it, you've buying it TWICE with your taxes, without even getting it.</p>\n<p>If someone uses EBT or theft to get the food, then sells it on the street or to a bodega to resell, congratulations moron, you've bought it thee times.</p>\n<p>The purpose is clearly not to reduce the cost of food.</p>\n<p>PS: There will also be runs on the stores, and the food then resold to bodegas or sold on the street. You'll have to get the food that way because the Mamdani shops will have been emptied out by the ghetto speculators.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 2, "score_up": 72, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2081915897325740069", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATC4efN6i", "is_twitter": true, "is_admin": false, "score": 38, "suggested_sort": 0, "post_flair_class": "pocrime", "id": 8751234, "raw_conten