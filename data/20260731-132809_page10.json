ommunity": "TheDonald", "ad_tier": 2, "last_comment_author": "t-bone", "is_video": false, "video_link": "", "is_new_user": false, "domain": "nltimes.nl", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATC4kMAmy.png", "removal_source": "", "link": "https://nltimes.nl/2026/07/29/low-water-level-deventer-port-closed-saturday-twente-asks-govt-support", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "A drought is about to do to Europe what the Iran war couldn't. The Rhine, the 800-mile river running through the industrial heart of Europe, is drying up. It carries the fuel, chemicals, and steel that feed factories across Switzerland, Germany, and France.", "last_comment_created": 1785512719000, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 6, "score_up": 21, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"description": "The port of Deventer will be closed until further notice from Saturday. The municipality has announced that the lock will not reopen because the water level in the IJssel is expected to drop below a critical threshold. Ships have until Friday evening to leave the harbor, or they will be stuck in Deventer indefinitely. The Twente region has asked the Central government to financially support the companies affected by the indefinite closure of the Twente Canal.", "large_image": "e8jwahkfqboljts8.png", "title": "Low water level: Deventer port closed from Saturday; Twente asks for gov't support"}, "post_flair_text": "", "archive_id": ""}], "status": true}