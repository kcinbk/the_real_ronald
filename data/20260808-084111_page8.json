es": 13286}}, "post_flair_text": "\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0RALLY TIME!\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATC9UQ3ug", "is_twitter": false, "is_admin": false, "score": 34, "suggested_sort": 0, "post_flair_class": "", "id": 8769396, "raw_content": "Went to the emergency room this afternoon because I\u2019m all fucked up. Pack a day smoker + Weed Vaper. Coughed so hard, I tore my muscles up and couldn\u2019t breathe. Got to the hospital and one of the first things they tried to do was give me a COVID test and I said no. They tried to pressure me and I told them the jig is up on COVID. Then they wanted to give me a vaccine and I said absolutely not. I told them they should knock that shit off because Trust the Science Fauci just wrote in his \u201cdiary\u201d that it was all lies and then he plead the 5th on \u201cthe Science\u201d I\u2019m getting my gall bladder out in the morning. They have me isolated in my own area of the hospital and they all have to wear space suits when they\u2019re around me. Ridiculous that this is still going on.", "author": "Apersonofinterest", "created": 1786166840520, "profile_picture": "MOo83KItJ6AX", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "MusicToMyEars", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Medical Emergency COVID test and Vaccine Pressure", "last_comment_created": 1786185781297, "content": "<p>Went to the emergency room this afternoon because I\u2019m all fucked up. Pack a day smoker + Weed Vaper. Coughed so hard, I tore my muscles up and couldn\u2019t breathe. Got to the hospital and one of the first things they tried to do was give me a COVID test and I said no. They tried to pressure me and I told them the jig is up on COVID. Then they wanted to give me a vaccine and I said absolutely not. I told them they should knock that shit off because Trust the Science Fauci just wrote in his \u201cdiary\u201d that it was all lies and then he plead the 5th on \u201cthe Science\u201d I\u2019m getting my gall bladder out in the morning. They have me isolated in my own area of the hospital and they all have to wear space suits when they\u2019re around me. Ridiculous that this is still going on.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 14, "score_up": 34, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATC9UQ3JX", "is_twitter": false, "is_admin": false, "score": 46, "suggested_sort": 0, "post_flair_class": "", "id": 8769307, "raw_content": "", "author": "SALTYinSeattle", "created": 1786160097694, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "SoulSnipper", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.patriots.win", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATC9UQ3JX.png", "removal_source": "", "link": "https://media.patriots.win/post/gR5utEQickEu.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/8zMMhNcmxa5zvpW7.jpeg", "width": 569, "content-type": "jpeg", "height": 768}], "blurhash": "UXJ@OMRRS|JW.RjEbcXS_Ns.WCxtrqNf$|s;", "full_resolution": [1458, 1080]}, "title": "Uhhh...  that's NOT Rosie. ", "last_comment_created": 1786163854215, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is