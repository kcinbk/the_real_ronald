icial 2025 declaration of assets, the total value of his family\u2019s wealth exceeds one million dollars, of which $595,000 is in cash. The remaining assets are distributed across several bank accounts\u2014including one in Zurich holding 346,483 euros\u2014and the concealed funds have been embezzled.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 20, "score_up": 215, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1AToPcTeoV", "is_twitter": false, "is_admin": false, "score": 31, "suggested_sort": 0, "post_flair_class": "", "id": 8905043, "raw_content": "", "author": "SALTYinSeattle", "created": 1792961603705, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "Auroraalpha", "is_video": false, "video_link": "", "is_new_user": false, "domain": "media.scored.co", "is_crosspost": false, "preview": "https://media.scored.co/preview/1AToPcTeoV.png", "removal_source": "", "link": "https://media.scored.co/post/tK443NMpKA7J.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/7gEUfFXLpymblmFg.jpeg", "width": 376, "content-type": "jpeg", "height": 768}], "blurhash": "U697X~8|4oJ$00_2-Vrw~pIBbdXRIT%hV@WB", "full_resolution": [2204, 1080]}, "title": "Pallets of Ballots INCOMING ", "last_comment_created": 1792966036238, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 12, "score_up": 31, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id"