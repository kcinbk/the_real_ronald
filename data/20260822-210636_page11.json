eo_link": "", "is_new_user": false, "domain": "media.scored.co", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATCNRaalI.png", "removal_source": "", "link": "https://media.scored.co/post/Q6A5msSCza2A.jpeg", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [{"reference": "/scale/YSpv2JTr5iLWtX8S.png", "width": 726, "content-type": "png", "height": 768}], "blurhash": "UaLM@L_1~UD%*_Sd9bkEm@D*s*$_X3kDsrog", "full_resolution": [780, 737]}, "title": "America is being saved!  In Jesus' Name!", "last_comment_created": 1787411643042, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": true, "comments": 2, "score_up": 112, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATCNRbyPE", "is_twitter": false, "is_admin": false, "score": 22, "suggested_sort": 0, "post_flair_class": "", "id": 8793584, "raw_content": "American Ranchers crying about the temporary 90 day tariff quota lifting for 300,000 metric tons of ground beef don't even have my sympathy.\n\nIts been how many years since \"lowest herd in 75 years\"? 2? 3? 4 years now?\n\nHave they taken any steps to increase the herd? It takes 2-3 years to go from calf to salable cattle. So we should have had some relief by now right? But no, the number keeps going down. Why?\n\nI'll tell you why. They are enjoying record profits right now by raising less cattle and selling it for 4 times the price.\n\nIts short-sighted anti-American business practice. Instead of pulling heifers and breeding them they are sending them to slaughter for big profits.\n\nSo while American consumers have spent years being told they are rebuilding the herd they have rebuilt nothing and we're supposed to continue to shoulder the high prices and burden of their profits? \n\nCall me anti-American call me whatever you want but I don't give a fuck anymore. There is a demand for beef and the American industry is failing to meet it or even attempting to meet it.\n\nOh and while they cry about \"America first\" and \"Buy American\" they are all importing cheap foreign cattle feed. Guess its only us suckers that should buy their American Beef, but they can buy foreign feed. ", "author": "inksday", "created": 1787430582824, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "wartooth6", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "American Ranchers crying", "last_comment_created": 1787436501304, "content": "<p>American Ranchers crying about the temporary 90 day tariff quota lifting for 300,000 metric tons of ground beef don't even have my sympathy.</p>\n<p>Its been how many years since &quot;lowest herd in 75 years&quot;? 2? 3? 4 years now?</p>\n<p>Have they taken any steps to increase the herd? It takes 2-3 years to go from calf to salable cattle. So we should have had some relief by now right? But no, the number keeps going down. Why?</p>\n<p>I'll tell you why. They are enjoying record profits right now by raising less cattle and selling it for 4 times the price.</p>\n<p>Its short-sighted anti-American business practice. Instead of pulling heifers and breeding them they are sending them to slaughter for big profits.</p>\n<p>So while American consumers have spent years being told they are rebuilding the herd they have rebuilt nothing and we're supposed to continue to shoulder the high prices and burden of their profits?</p>\n<p>Call me anti-American call me whatever you want but I don't give a fuck anymore. There is a demand for beef and the American industry is failing to meet it or even attempting to meet it.</p>\n<p>Oh and while they cry about &quot;America first&quot; and &quot;Buy American&quot; they are all importing cheap foreign cattle feed. Guess its only us suckers that should buy their American Beef, but they can buy foreign feed.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 17, "score_up": 22, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2091270622374498716", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATCNRcWN0", "is_twitter": true, "is_admin": false, "score": 14, "suggested_sort": 0, "post_flair_class": "", "id": 8793762, "raw_content": "", "author": "PiratePatriotParrot", "created": 1787439311305, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "SonSaviorKing", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATCNRcWN0.png", "removal_source": "", "link": "https://twitter.com/AmiriKing/status/2091270622374498716?s=20", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Neighbors in Aurora built a community garden.\n\nYou\u2019ll never guess who came by to destroy it.\n\n\u270a\ud83c\udfff excellence.\n", "last_comment_created": 1787446313178, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 7, "score_up": 14, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": false, "linkEmbed