s_twitter": true, "is_admin": false, "score": 77, "suggested_sort": 0, "post_flair_class": "", "id": 8827916, "raw_content": "", "author": "Herpawinski", "created": 1789066135211, "profile_picture": "GCJCeufYDd47", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "coffee_grdr", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVCroffa.png", "removal_source": "", "link": "https://twitter.com/ClownWorld/status/2098106234457002481", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Oh look. That thing that never happens happened yet again.", "last_comment_created": 1789092050872, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 4, "score_up": 77, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": false, "images": [{"width": 1231, "heightRatio": 98, "url": "https://pbs.twimg.com/media/HR34gF1W0AYETEd.jpg", "height": 1218}], "linkEmbed": false, "replies": 20, "created": 1789062481000, "id": "2098106234457002481", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2007190860690046977/ZAITQvgd_normal.jpg", "displayName": "Clown World \u2122 \ud83e\udd21", "username": "ClownWorld"}, "content": "Federal agents went looking for James Brass, also known as \u201cLord,\u201d early Thursday morning over election fraud operation in Los Angeles. But when they arrived at his usual Skid Row location, he was already gone. Authorities say he had left around 5 AM.\n\nThey eventually tracked him", "parentTweet": false, "likes": 385}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "2098085522212069702", "sticky_comment": 0, "is_video_mp4": false, "type": "link", "uuid": "1ATVCsub10", "is_twitter": true, "is_admin": false, "score": 63, "suggested_sort": 0, "post_flair_class": "", "id": 8828052, "raw_content": "", "author": "LiberaIPussyGuy", "created": 1789070118863, "profile_picture": "kUZP54YGIYuT", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "LiberaIPussyGuy", "is_video": false, "video_link": "", "is_new_user": false, "domain": "twitter.com", "is_crosspost": false, "preview": "https://media.scored.co/preview/1ATVCsub10.png", "removal_source": "", "link": "https://twitter.com/catturd2/status/2098085522212069702?s=20", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "Roof Inspector?  That's RACIST!", "last_comment_created": 1789094195717, "content": "", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 11, "score_up": 63, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"twitter": {"quotedTweet": {"quotedTweet": false, "images": false, "linkEmbed": false, "replies": 0, "created": 1789056130000, "id": "2098079595186557138", "video": {"preview": "https://pbs.twimg.com/amplify_video_thumb/2098037508374192135/img/tfYZgsIM2Bv4rAte.jpg", "mpeg": "https://video.twimg.com/amplify_video/2098037508374192135/pl/E4tTkqMYcYkzpejF.m3u8?tag=16&v=cfc", "aspectRatio": [9, 16], "heightRatio": 177, "type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2098037508374192135/vid/avc1/320x568/VOw-3wWk4c_OSrsm.mp4?tag=16"}, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/619546088995979264/KuG27bBK_normal.jpg", "displayName": "Breaking911", "username": "Breaking911"}, "content": "An insurance adjuster fell through the ceiling and landed in a South Carolina home\u2019s kitchen during a routine roof inspection.", "parentTweet": false, "likes": 1511}, "images": false, "linkEmbed": false, "replies": 113, "created": 1789057543000, "id": "2098085522212069702", "video": false, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/1043187066832650240/6iaOQ7xL_normal.jpg", "displayName": "Catturd \u2122", "username": "catturd2"}, "content": "Yes - walking on the sheetrock will do that every time.", "parentTweet": false, "likes": 1223}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1ATVCsvySX", "is_twitter": false, "is_admin": false, "score": 26, "suggested_sort": 0, "post_flair_class": "", "id": 8828581, "raw_content": "Mid-term polling is looking dismal.  My personal opinion is he forgot why we elected him.  We should have several massive legislative victories by now, but all I see is dog shit.  Yes, I understand executive orders have limits.  Yes, I understand (D) activists judges are stalling every lawsuit as long as possible.  Yes, I understand real change comes from legislation (that Congress is sitting on.)\n\nSo flip the script back in their faces.\n\nPublish a plan for the mid-term wins.  Just like Gingrich did.  What legislation will be pushed though in the first 100 days.  ***Then emphasize the importance of achieving the largest majorities in the House & Senate as possible.*** \n\nFor example:\n\n55% + in the House and Senate give us:\n- Election Integrity [SAVE] Act (single-day in-person voting, paper ballots, hand counting, no machines)\n- Immigration Act (repealing the '65 Immigration Act in its entirety, and repealing the '90 Temporary Protected Status nonsense)\n- Visa Act (all visa programs cancelled, all marital visas automatically revoked upon divorce, no economic visas unless US unemployment is under 3% annually for the last 5 consecutive years, automatic deportation upon discovery regardless of location, etc.) \n- Military Pay Raises Act. \n- No Tax on Social Security Act. \n- Repeal Osamacare Act \n- Health Insurance Companies Must Be Non-profit and Permitted To Operate Beyond State Boundries Act.\n\n67%+ in the House and Senate:  (the magical 2/3's majority)\n- Term Limits amendment\n- Balanced Budget amendment\n- Election Integrity amendment\n- Judical Review & Removal amendment\n- - - - -\n***(p.s. publicly denounce John Thune, and get someone as Senate Leader that isn't a RINO for a change.)***", "author": "greatpumpkin", "created": 1789087122848, "profile_picture": "THJfFaQLwuCH", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "President Trump, if you want to win the mid-terms, you need to channel the ghost of Newt Gingrich's \"Contract With America\"; get it in front of the public day & night.", "last_comment_created": 1789087122847, "content": "<p>Mid-term polling is looking dismal.  My personal opinion is he forgot why we elected him.  We should have several massive legislative victories by now, but all I see is dog shit.  Yes, I understand executive orders have limits.  Yes, I understand (D) activists judges are stalling every lawsuit as long as possible.  Yes, I understand real change comes from legislation (that Congress is sitting on.)</p>\n<p>So flip the script back in their faces.</p>\n<p>Publish a plan for the mid-term wins.  Just like Gingrich did.  What legislation will be pushed though in the first 100 days.  <em><strong>Then emphasize the importance of achieving the largest majorities in the House &amp; Senate as possible.</strong></em></p>\n<p>For example:</p>\n<p>55% + in the House and Senate give us:</p>\n<ul>\n<li>Election Integrity [SAVE] Act (single-day in-person voting, paper ballots, hand counting, no machines)</li>\n<li>Immigration Act (repealing the '65 Immigration Act in its entirety, and repealing the '90 Temporary Protected Status nonsense)</li>\n<li>Visa Act (all visa programs cancelled, all marital visas automatically revoked upon divorce, no economic visas unless US unemployment is under 3% annually for the last 5 consecutive years, automatic deportation upon discovery regardless of location, etc.)</li>\n<li>Military Pay Raises Act.</li>\n<li>No Tax on Social Security Act.</li>\n<li>Repeal Osamacare Act</li>\n<li>Health Insurance Companies Must Be Non-profit and Permitted To Operate Beyond State Boundries Act.</li>\n</ul>\n<p>67%+ in the House and Senate:  (the magical 2/3's majority)</p>\n<ul>\n<li>Term Limits amendment</li>\n<li>Balanced Budget amendment</li>\n<li>Election Integrity amendment</li>\n<li>Judical Review &amp; Removal amendment</li>\n</ul>\n<hr />\n<p><em><strong>(p.s. publicly denounce John Thune, and get someone as Senate Leader that isn't a RINO for a change.)</strong></em></p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 0, "score_up": 26, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}], "status": true}