mplify_video/2117307694025482240/vid/avc1/320x568/PDUKx7FuEz4DY2fW.mp4"}, "poll": false, "user": {"profilePicture": "https://pbs.twimg.com/profile_images/2089181391149731840/IGulidOh_normal.jpg", "displayName": "Eric Spracklen \ud83c\uddfa\ud83c\uddf8", "username": "EricSpracklen"}, "content": "Yeah\u2026this guy is all of us.", "parentTweet": false, "likes": 1205}}, "post_flair_text": "", "archive_id": ""}, {"is_locked": false, "tweet_id": "", "sticky_comment": 0, "is_video_mp4": false, "type": "text", "uuid": "1AToYvJ2pS", "is_twitter": false, "is_admin": false, "score": 206, "suggested_sort": 0, "post_flair_class": "", "id": 8921986, "raw_content": "- TX pop grew 390K past two years.  \n\n-Dems got 340K more votes, so we know how Jeets & Cali imports voted.  Crazy that they had higher turnout in a midterm year. \n\n-But Rs got 1.9M fewer votes.  Seems like the base was demoralized.  \n\n-Total turnout was 1.6M less than in the 2024 general.  \n\nThe whining about millions of jeets being imported doesn't match the actual stats.  This was a turnout issue.  If you cut that 1.9M in half and actually got those people out to vote then TX would have stayed red. ", "author": "AccipiterQQ", "created": 1793798442131, "profile_picture": "", "community": "TheDonald", "ad_tier": 2, "last_comment_author": "mathteach314159", "is_video": false, "video_link": "", "is_new_user": false, "domain": "", "is_crosspost": false, "preview": "", "removal_source": "", "link": "", "author_flair_class": "", "is_removed": false, "media": {"resized_resolutions": [], "blurhash": "", "full_resolution": []}, "title": "No, TX did not flip because of imported Jeets or Californians.  I did the math inside...", "last_comment_created": 1793819783278, "content": "<ul>\n<li>TX pop grew 390K past two years.</li>\n</ul>\n<p>-Dems got 340K more votes, so we know how Jeets &amp; Cali imports voted.  Crazy that they had higher turnout in a midterm year.</p>\n<p>-But Rs got 1.9M fewer votes.  Seems like the base was demoralized.</p>\n<p>-Total turnout was 1.6M less than in the 2024 general.</p>\n<p>The whining about millions of jeets being imported doesn't match the actual stats.  This was a turnout issue.  If you cut that 1.9M in half and actually got those people out to vote then TX would have stayed red.</p>\n", "score_down": 0, "author_flair_text": "", "pro_tier": 0, "is_stickied": false, "is_nsfw": false, "is_deleted": false, "is_image": false, "comments": 70, "score_up": 206, "is_edited": false, "is_moderator": false, "awards": 0, "vote_state": 2, "link_metadata": {"status": 200}, "post_flair_text": "", "archive_id": ""}], "status": true}